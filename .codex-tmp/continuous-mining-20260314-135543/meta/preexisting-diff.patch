+    network_id: [u8; 32],
+    state_root: [u8; 32],
+    bls_sk: &pc_crypto::BlsSecretKey,
+) -> AnchorHeaderV2 {
+    signed_finality_header_for_payload(network_id, [0x44; 32], state_root, bls_sk)
