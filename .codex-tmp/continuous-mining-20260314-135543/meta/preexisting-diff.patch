+async fn recv_outbox<T, F>(rx: &mut mpsc::Receiver<P2pMessage>, mut map: F) -> Result<T>
+where
+    F: FnMut(P2pMessage) -> Option<T>,
+{
+    timeout(Duration::from_secs(2), async {
+        loop {
+            let msg = rx
+                .recv()
+                .await
+                .ok_or_else(|| anyhow!("p2p outbox closed"))?;
+            if let Some(value) = map(msg) {
+                return Ok(value);
+            }
+        }
+    })
+    .await
+    .map_err(|_| anyhow!("timed out waiting for p2p outbox message"))?
+}
