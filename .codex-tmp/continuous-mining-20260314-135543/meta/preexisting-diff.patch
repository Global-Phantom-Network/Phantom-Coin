+    let body = status_serve_get(status_addr, token, client, &path).await?;
+    let value: StatusServeLocalPrevoteContextResp = serde_json::from_str(&body)
+        .map_err(|e| format!("StatusServe LocalPrevoteContext-JSON ungültig: {e}"))?;
+    if !value.ok {
+        return Err(format!(
