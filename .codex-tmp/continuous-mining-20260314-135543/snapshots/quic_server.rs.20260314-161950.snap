use super::*;

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) enum CandidateScopeAdvance {
    Unchanged,
    Initialized,
    Reset { previous: ([u8; 32], u64) },
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) enum MintFileReadDisposition {
    SkipTransientMissing,
    DropUnreadable,
}

pub(crate) fn advance_candidate_scope<T>(
    active_scope: &mut Option<([u8; 32], u64)>,
    new_scope: ([u8; 32], u64),
    candidate_nonce_cursor: &mut HashMap<[u8; 32], u64>,
    emitted_candidate_work: &mut HashMap<[u8; 32], T>,
) -> CandidateScopeAdvance {
    if *active_scope == Some(new_scope) {
        return CandidateScopeAdvance::Unchanged;
    }

    let transition = match *active_scope {
        Some(previous) => CandidateScopeAdvance::Reset { previous },
        None => CandidateScopeAdvance::Initialized,
    };

    *active_scope = Some(new_scope);
    candidate_nonce_cursor.clear();
    emitted_candidate_work.clear();
    transition
}

pub(crate) fn classify_mint_file_read_error(err: &std::io::Error) -> MintFileReadDisposition {
    if err.kind() == std::io::ErrorKind::NotFound {
        MintFileReadDisposition::SkipTransientMissing
    } else {
        MintFileReadDisposition::DropUnreadable
    }
}

pub(crate) fn runtime_candidate_work_id(
    work_id: [u8; 32],
    candidate_feature_bits: u64,
) -> Option<[u8; 32]> {
    if (candidate_feature_bits & pc_types::MINT_CANDIDATE_FEATURE_WORK_ID_V1) != 0 {
        Some(work_id)
    } else {
        None
    }
}

pub(crate) fn should_log_bootstrap_evidence_drop(reason: &str) -> bool {
    reason != "work_id feature disabled"
}

pub(crate) fn run_p2p_quic_listen(args: &P2pQuicListenArgs) -> Result<()> {
    let rt = tokio::runtime::Builder::new_multi_thread()
        .enable_all()
        .build()
        .map_err(|e| anyhow!("failed to build tokio runtime: {e}"))?;
    rt.block_on(async move {
        use pc_p2p::P2pConfig;
        use pc_p2p::async_svc as p2p_async;

        let store_dir = crate::store_path::resolve_store_dir_value(&args.store_dir, args.unsafe_confirm)?
            .to_string_lossy()
            .to_string();

        let _ = import_peer_lists(&store_dir, &args.peers_import);

        let mempool_dir = std::path::Path::new(&store_dir)
            .join("mempool")
            .to_string_lossy()
            .to_string();
        let role_policy = load_role_policy_from_mempool(&mempool_dir)?.map(Arc::new);
        if let Some(policy) = role_policy.as_ref() {
            println!(
                "{{\"type\":\"role_policy_loaded\",\"mint_locks\":{},\"validator_ids\":{}}}",
                policy.mint_locks_len(),
                policy.validator_ids_len()
            );
        }

        // Validator-ID auflösen (bls_pk oder validator_id)
        let validator_id = resolve_validator_id(args);
        if args.tx_proposer && role_policy.is_some() && validator_id.is_none() {
            return Err(anyhow!(
                "--tx-proposer requires --validator-id or --bls-pk when --role-policy is active"
            ));
        }

        let eligibility = check_validator_eligibility(
            validator_id,
            role_policy.as_ref().map(|p| p.as_ref()),
            &store_dir,
        )
        .await;
        // Export initial local validator/role gauges (best-effort).
        NODE_VALIDATOR_ID_CONFIGURED.store(u64::from(validator_id.is_some()), Ordering::Relaxed);
        NODE_VALIDATOR_STAKE.store(eligibility.stake, Ordering::Relaxed);
        NODE_VALIDATOR_MIN_STAKE.store(pc_consensus::consts::MIN_ATTESTOR_STAKE, Ordering::Relaxed);
        NODE_VALIDATOR_POP_OK.store(u64::from(eligibility.pop_ok), Ordering::Relaxed);
        NODE_VALIDATOR_POLICY_OK.store(u64::from(eligibility.policy_ok), Ordering::Relaxed);
        NODE_VALIDATOR_ELIGIBLE.store(u64::from(eligibility.eligible), Ordering::Relaxed);
        if let Some(vid) = validator_id {
            if args.tx_proposer && !eligibility.policy_ok {
                return Err(anyhow!(
                    "role_policy forbids validator_id {}",
                    hex::encode(vid)
                ));
            }
            let min_stake = pc_consensus::consts::MIN_ATTESTOR_STAKE;
            println!(
                "{{\"type\":\"role_check\",\"validator_id\":\"{}\",\"stake\":{},\"min_stake\":{},\"pop_ok\":{},\"policy_ok\":{},\"eligible\":{}}}",
                hex::encode(vid),
                eligibility.stake,
                min_stake,
                eligibility.pop_ok,
                eligibility.policy_ok,
                eligibility.eligible
            );
        } else {
            println!("{{\"type\":\"role_check\",\"status\":\"no_validator_id\",\"role\":\"fullnode\"}}");
        }

        // tx_proposer aktivieren wenn: explizit gesetzt ODER dynamisch als Validator erkannt
        let tx_proposer_effective = args.tx_proposer || eligibility.eligible;
        if tx_proposer_effective && !args.tx_proposer {
            println!("{{\"type\":\"dynamic_role\",\"role\":\"validator\",\"tx_proposer\":true}}");
        }
        let own_role_flags = if args.pow_miner {
            ROLE_MINER
        } else if tx_proposer_effective {
            ROLE_VALIDATOR
        } else {
            ROLE_FULLNODE
        };
        NODE_ROLE_FLAGS_GAUGE.store(own_role_flags as u64, Ordering::Relaxed);

        // Prozess-Metriken im Hintergrund aktualisieren (best-effort).
        tokio::spawn(async move {
            let pid = Pid::from_u32(std::process::id());
            let mut sys = System::new();
            loop {
                sys.refresh_process(pid);
                if let Some(p) = sys.process(pid) {
                    let cpu = p.cpu_usage() as f64;
                    let v = if cpu.is_finite() && cpu >= 0.0 {
                        (cpu * 1_000_000.0) as u64
                    } else {
                        0
                    };
                    NODE_PROCESS_CPU_PCT_MICRO.store(v, Ordering::Relaxed);
                    let rss = p.memory();
                    NODE_PROCESS_RSS_BYTES.store(rss, Ordering::Relaxed);
                }
                tokio::time::sleep(Duration::from_secs(2)).await;
            }
        });

        // Validator Control (fail-safe, single source of truth)
        let control_path = validator_control_path(&store_dir);
        let proposer_enabled = Arc::new(AtomicBool::new(false));
        let proposer_enabled_flag = proposer_enabled.clone();
        let role_policy_ctrl = role_policy.clone();
        let store_dir_ctrl = store_dir.clone();
        let explicit_proposer = args.tx_proposer;
        let validator_id_ctrl = validator_id;
        tokio::spawn(async move {
            let mut last_enabled: Option<bool> = None;
            let mut last_conditions_ok: Option<bool> = None;
            loop {
                let mut created_default = false;
                let mut control = if control_path.exists() {
                    load_validator_control(&control_path)
                } else {
                    created_default = true;
                    pcfg::default_validator_control_fail_closed().unwrap_or_else(|e| {
                        warn!(err = %e, "now_secs failed; using updated_at=0 for fail-closed defaults");
                        ValidatorControl::default_fail_closed_at(0)
                    })
                };

                let now = match pcfg::now_secs() {
                    Ok(v) => v,
                    Err(e) => {
                        warn!(err = %e, "system clock error; forcing validator voting disabled");
                        proposer_enabled_flag.store(false, Ordering::Relaxed);
                        NODE_VALIDATOR_VOTING_ENABLED.store(0, Ordering::Relaxed);
                        tokio::time::sleep(Duration::from_secs(2)).await;
                        continue;
                    }
                };
                let eligibility = check_validator_eligibility(
                    validator_id_ctrl,
                    role_policy_ctrl.as_ref().map(|p| p.as_ref()),
                    &store_dir_ctrl,
                )
                .await;
                // Export local eligibility gauges (best-effort, no labels).
                NODE_VALIDATOR_ID_CONFIGURED.store(
                    u64::from(validator_id_ctrl.is_some()),
                    Ordering::Relaxed,
                );
                NODE_VALIDATOR_STAKE.store(eligibility.stake, Ordering::Relaxed);
                NODE_VALIDATOR_MIN_STAKE.store(pc_consensus::consts::MIN_ATTESTOR_STAKE, Ordering::Relaxed);
                NODE_VALIDATOR_POP_OK.store(u64::from(eligibility.pop_ok), Ordering::Relaxed);
                NODE_VALIDATOR_POLICY_OK.store(u64::from(eligibility.policy_ok), Ordering::Relaxed);
                NODE_VALIDATOR_ELIGIBLE.store(u64::from(eligibility.eligible), Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_KILL_SWITCH.store(u64::from(control.kill_switch), Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_MAINTENANCE.store(u64::from(control.maintenance), Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_MANUAL_DISABLE.store(u64::from(control.manual_disable), Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_AUTO_REENABLE.store(u64::from(control.auto_reenable), Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_COOLDOWN_UNTIL_EPOCH.store(control.cooldown_until, Ordering::Relaxed);
                NODE_VALIDATOR_CONTROL_UPDATED_AT_EPOCH.store(control.updated_at, Ordering::Relaxed);

                // Bedingungen OK: expliziter Proposer oder eligible
                let conditions_ok = if explicit_proposer {
                    eligibility.policy_ok
                } else {
                    eligibility.eligible
                };
                let base_allowed = explicit_proposer || eligibility.eligible;
                NODE_VALIDATOR_CONDITIONS_OK.store(u64::from(conditions_ok), Ordering::Relaxed);

                let mut updated = false;
                if created_default {
                    control.updated_at = now;
                    control.last_changed_by = "node".to_string();
                    updated = true;
                }

                if last_conditions_ok.unwrap_or(true) && !conditions_ok {
                    let cooldown_target = now.saturating_add(60);
                    if control.cooldown_until < cooldown_target {
                        control.cooldown_until = cooldown_target;
                        control.reason = "auto-disabled: conditions not ok".to_string();
                        control.updated_at = now;
                        control.last_changed_by = "node".to_string();
                        updated = true;
                    }
                    if !control.auto_reenable && !control.manual_disable {
                        control.manual_disable = true;
                        control.reason = "auto-disabled: conditions not ok (manual mode)".to_string();
                        control.updated_at = now;
                        control.last_changed_by = "node".to_string();
                        updated = true;
                    }
                }
                last_conditions_ok = Some(conditions_ok);

                if updated {
                    if let Err(e) = pcfg::save_validator_control_to_file(&control, &control_path) {
                        warn!(path = %control_path.display(), err = %e, "validator_control save failed");
                    }
                }

                let disabled = control.kill_switch
                    || control.maintenance
                    || control.manual_disable
                    || control.cooldown_until > now
                    || !conditions_ok;
                let enabled = base_allowed && !disabled;
                NODE_VALIDATOR_VOTING_ENABLED.store(u64::from(enabled), Ordering::Relaxed);

                if last_enabled.map(|v| v != enabled).unwrap_or(true) {
                    proposer_enabled_flag.store(enabled, Ordering::Relaxed);
                    last_enabled = Some(enabled);
                    if enabled {
                        info!(reason = %control.reason, "validator voting enabled");
                    } else {
                        warn!(reason = %control.reason, "validator voting disabled");
                    }
                }

                tokio::time::sleep(Duration::from_secs(2)).await;
            }
        });

        let peers_json = std::path::Path::new(&store_dir).join("peers.json");
        let store = FileStore::open(&store_dir, args.fsync)?;
        println!(
            "{{\"type\":\"store_opened\",\"dir\":\"{}\",\"fsync\":{}}}",
            &store_dir, args.fsync
        );
        {
            let t0 = std::time::Instant::now();
            let mstats = store.migrate_legacy_payloads(true)?;
            let dt = t0.elapsed();
            if mstats.migrated > 0 || mstats.errors > 0 {
                println!(
                    "{{\"type\":\"payload_migration\",\"migrated\":{},\"skipped\":{},\"deleted\":{},\"errors\":{},\"duration_ms\":{}}}",
                    mstats.migrated, mstats.skipped, mstats.deleted, mstats.errors, dt.as_millis(),
                );
            }
        }
        // Cache-Kapazitäten: CLI > Config > 0
        // k aus Config wird hier auch einmalig mitgelesen (damit wir die Datei nicht doppelt parsen).
        let (cfg_hdr_cap, cfg_pl_mb, cfg_k_opt, cfg_rate) = if let Some(ref path) = args.config {
            let nc = load_node_config(path)?;
            let h = nc
                .node
                .as_ref()
                .and_then(|n| n.cache.as_ref())
                .and_then(|c| c.header_cap)
                .unwrap_or(0);
            let p = nc
                .node
                .as_ref()
                .and_then(|n| n.cache.as_ref())
                .and_then(|c| c.payload_mb)
                .unwrap_or(0);
            let k = nc.consensus.and_then(|c| c.k);
            let rate = nc.node.as_ref().and_then(|n| n.rate);
            (h, p, k, rate)
        } else {
            (0usize, 0usize, None, None)
        };
        let hdr_cap_eff = args.cache_hdr_cap.unwrap_or(cfg_hdr_cap);
        let pl_mb_eff = args.cache_pl_mb.unwrap_or(cfg_pl_mb);
        let cfg = P2pConfig {
            max_peers: 256,
            rate: effective_rate_cfg(&args.rate, cfg_rate.as_ref()),
            peers_json_path: Some(peers_json),
        };

        // k aus Genesis (falls vorhanden) oder Config/CLI ableiten; Genesis hat Vorrang
        let k_eff = if let Some(ref gpath) = args.genesis {
            let g = load_genesis(gpath)?;
            let k = g.consensus.k;
            if k == 0 || k > 64 {
                return Err(anyhow!(
                    "invalid k in genesis: {} (must be 1..=64)",
                    k
                ));
            }
            println!(
                "{{\"type\":\"genesis_loaded\",\"k\":{},\"commitment\":\"{}\"}}",
                k, g.commitment
            );
            k
        } else {
            let k = cfg_k_opt.unwrap_or(args.k);
            if k == 0 || k > 64 {
                return Err(anyhow!("invalid k: {} (must be 1..=64)", k));
            }
            println!(
                "{{\"type\":\"k_selected\",\"k\":{},\"source\":\"{}\"}}",
                k,
                if args.config.is_some() { "config" } else { "cli" }
            );
            k
        };

        let delegate = NodeDiskStore::new(
            store,
            &store_dir,
            args.fsync,
            hdr_cap_eff,
            pl_mb_eff,
            Some(k_eff),
            role_policy.clone(),
        );
        let (svc, mut out_rx, handle) = p2p_async::spawn_with_store(cfg, Arc::new(delegate));

        // WICHTIG: inbound_subscribe() MUSS vor start_server aufgerufen werden,
        // damit der broadcast-Channel initialisiert ist, bevor Nachrichten ankommen.
        // Sonst werden frühe Nachrichten still verworfen (Race-Condition).
        let _init_inbound = inbound_subscribe();

        let addr: SocketAddr = parse_quic_addr(&args.addr)?;
        // Hardening: binding QUIC P2P to a non-loopback address exposes a public listener.
        // Require an explicit acknowledgement via --unsafe-confirm to reduce accidental exposure.
        if !addr.ip().is_loopback() && !args.unsafe_confirm {
            return Err(anyhow!(
                "Refusing to bind P2P to non-loopback addr {} without --unsafe-confirm. Use 127.0.0.1:9000 for local-only, or add --unsafe-confirm to acknowledge public exposure.",
                addr
            ));
        }
        let (_endpoint, cert_der, server_task, tx_broadcast) = start_server(addr, svc.clone())
            .await
            .map_err(|e| anyhow!("quic start_server failed: {e}"))?;
        println!(
            "{{\"type\":\"quic_listen\",\"addr\":\"{}\",\"cert_der\":\"{}\"}}",
            addr,
            hex::encode(&cert_der)
        );
        if let Some(path) = &args.cert_out {
            std::fs::write(path, &cert_der).map_err(|e| anyhow!("write cert_out failed: {e}"))?;
            println!("{{\"type\":\"cert_written\",\"path\":\"{}\"}}", path);
        }

        // DA-gating config (currently exported as gauges in /metrics; behaviour may be added later).
        let da_payload_wait_timeout_secs = args.da_payload_wait_timeout_secs.unwrap_or(3);
        let da_retry_initial_delay_ms = args.da_retry_initial_delay_ms.unwrap_or(100);
        let da_retry_max_delay_ms = args.da_retry_max_delay_ms.unwrap_or(300);
        let da_retry_max_retries = args.da_retry_max_retries.unwrap_or(2);
        let da_retry_jitter_pct = args.da_retry_jitter_pct.unwrap_or(12);
        if da_retry_jitter_pct > 100 {
            return Err(anyhow!("--da-retry-jitter-pct must be 0..=100"));
        }
        NODE_DA_GATING_CFG_PAYLOAD_WAIT_TIMEOUT_SECS.store(
            da_payload_wait_timeout_secs,
            Ordering::Relaxed,
        );
        NODE_DA_GATING_CFG_RETRY_INITIAL_DELAY_MS.store(da_retry_initial_delay_ms, Ordering::Relaxed);
        NODE_DA_GATING_CFG_RETRY_MAX_DELAY_MS.store(da_retry_max_delay_ms, Ordering::Relaxed);
        NODE_DA_GATING_CFG_RETRY_MAX_RETRIES.store(da_retry_max_retries as u64, Ordering::Relaxed);
        NODE_DA_GATING_CFG_RETRY_JITTER_PCT.store(da_retry_jitter_pct as u64, Ordering::Relaxed);

        // Optional: Prometheus metrics endpoint (in-process, loopback only).
        let mut metrics_shutdown_tx: Option<tokio::sync::oneshot::Sender<()>> = None;
        let mut metrics_task: Option<tokio::task::JoinHandle<Result<(), anyhow::Error>>> = None;
        if let Some(addr_str) = args.metrics_addr.as_deref() {
            let metrics_addr: SocketAddr = addr_str
                .parse()
                .map_err(|e| anyhow!("invalid metrics_addr '{}': {e}", addr_str))?;
            if !metrics_addr.ip().is_loopback() {
                return Err(anyhow!(
                    "metrics_addr darf nur auf 127.0.0.1/::1 binden (nicht öffentlich)"
                ));
            }
            let listener = std::net::TcpListener::bind(metrics_addr)
                .map_err(|e| anyhow!("bind metrics_addr '{}': {e}", addr_str))?;
            let actual = listener
                .local_addr()
                .map_err(|e| anyhow!("metrics listener local_addr: {e}"))?;
            let make_svc = make_service_fn(|_conn| async move {
                Ok::<_, Infallible>(service_fn(|req: Request<Body>| async move {
                    if req.uri().path() != "/metrics" {
                        let mut resp = Response::new(Body::from("Not Found"));
                        *resp.status_mut() = hyper::StatusCode::NOT_FOUND;
                        resp.headers_mut().insert(
                            hyper::header::CONTENT_TYPE,
                            hyper::header::HeaderValue::from_static("text/plain"),
                        );
                        return Ok::<_, Infallible>(resp);
                    }
                    let body = render_p2p_metrics_prometheus_text();
                    let mut resp = Response::new(Body::from(body));
                    resp.headers_mut().insert(
                        hyper::header::CONTENT_TYPE,
                        hyper::header::HeaderValue::from_static("text/plain; version=0.0.4"),
                    );
                    Ok::<_, Infallible>(resp)
                }))
            });
            let server = Server::from_tcp(listener)
                .map_err(|e| anyhow!("metrics server from_tcp: {e}"))?
                .serve(make_svc);
            println!("{{\"type\":\"metrics_serve\",\"addr\":\"{}\"}}", actual);
            let (tx, rx) = tokio::sync::oneshot::channel::<()>();
            metrics_shutdown_tx = Some(tx);
            let graceful = server.with_graceful_shutdown(async move {
                let _ = rx.await;
            });
            metrics_task = Some(tokio::spawn(async move {
                graceful.await.map_err(|e| anyhow!("metrics server error: {e}"))
            }));
        }

        let (out_tx, _) = tokio::sync::broadcast::channel::<P2pMessage>(256);
        let outbound_active: Arc<Mutex<HashSet<SocketAddr>>> = Arc::new(Mutex::new(HashSet::new()));
        let store_dir_for_dial = store_dir.clone();
        let svc_for_dial = svc.clone();
        let out_tx_dial = out_tx.clone();
        let outbound_active_dial = outbound_active.clone();
        let listen_addr = addr;
        let own_role_flags_for_dial = own_role_flags;
        tokio::spawn(async move {
            let mut tick = interval(Duration::from_secs(30));
            let mut last_attempt: HashMap<SocketAddr, Instant> = HashMap::new();
            let mut fail_counts: HashMap<SocketAddr, u32> = HashMap::new();
            let mut last_dns_fallback: Option<Instant> = None;
            let mut next_peer_request_at = Instant::now();
            loop {
                tick.tick().await;
                let dynamic_targets = load_dynamic_targets(&store_dir_for_dial, MAX_BOOTSTRAP_TARGETS);
                let mut new_connections = 0usize;
                if !dynamic_targets.is_empty() {
                    new_connections = try_connect_targets(
                        dynamic_targets,
                        true,
                        listen_addr,
                        &outbound_active_dial,
                        &mut last_attempt,
                        &mut fail_counts,
                        &store_dir_for_dial,
                        &svc_for_dial,
                        &out_tx_dial,
                        own_role_flags_for_dial,
                    )
                    .await;
                }

                if new_connections == 0
                    && last_dns_fallback
                        .map(|t| t.elapsed() >= Duration::from_secs(DNS_FALLBACK_INTERVAL_SECS))
                        .unwrap_or(true)
                {
                    let fallback = load_bootstrap_targets(&store_dir_for_dial);
                    if !fallback.is_empty() {
                        last_dns_fallback = Some(Instant::now());
                        let _ = try_connect_targets(
                            fallback,
                            false,
                            listen_addr,
                            &outbound_active_dial,
                            &mut last_attempt,
                            &mut fail_counts,
                            &store_dir_for_dial,
                            &svc_for_dial,
                            &out_tx_dial,
                            own_role_flags_for_dial,
                        )
                        .await;
                    }
                }

                let active_outbound = {
                    let guard = outbound_active_dial.lock().await;
                    guard.len()
                };
                if active_outbound > 0 && active_outbound < PEER_REQUEST_MIN_OUTBOUND {
                    let now = Instant::now();
                    if now >= next_peer_request_at {
                        let _ = svc_for_dial
                            .send_req(ReqMsg::GetPeers { max_count: PEER_REQUEST_SAMPLE })
                            .await;
                        let mut rng = rand::rng();
                        let jitter = rng.random_range(0..=PEER_REQUEST_JITTER_SECS);
                        next_peer_request_at =
                            now + Duration::from_secs(PEER_REQUEST_BASE_SECS + jitter);
                    }
                }
            }
        });

        let tx_b = tx_broadcast.clone();
        let forward_task = tokio::spawn(async move {
            while let Some(msg) = out_rx.recv().await {
                outbox_deq_inc();
                print_p2p_json(&msg);
                let _ = out_tx.send(msg.clone());
                let _ = tx_b.send(msg).await;
            }
            Ok::<(), anyhow::Error>(())
        });

        // pow_bits aus Genesis (falls vorhanden), sonst Default
        let pow_bits_eff: u8 = if let Some(ref gpath) = args.genesis {
            let g = load_genesis(gpath)?;
            let b = g.consensus.pow_bits.unwrap_or(consts::POW_DEFAULT_BITS);
            if (b as u16) > 256 { return Err(anyhow!("invalid pow_bits in genesis: {} (must be 0..=256)", b)); }
            println!("{{\"type\":\"pow_bits\",\"bits\":{}}}", b);
            b
        } else { consts::POW_DEFAULT_BITS };

        // Optional: Dev-PoW-Miner für Mint-Emission (nur im Listen-Server sinnvoll)
        let pow_miner_network_id = if args.pow_miner {
            let note_path = std::path::Path::new(&store_dir)
                .join("mempool")
                .join("genesis_note.bin");
            let buf = std::fs::read(&note_path)
                .map_err(|e| anyhow!("--pow-miner requires genesis_note.bin at {}: {e}", note_path.display()))?;
            let note = decode_genesis_note_exact(&buf)
                .map_err(|e| anyhow!("invalid genesis_note.bin: {e}"))?;
            Some(digest_genesis_note(&note))
        } else {
            None
        };

        if args.pow_miner {
            let network_id = pow_miner_network_id.unwrap_or([0u8; 32]);
            if network_id == [0u8; 32] {
                return Err(anyhow!("--pow-miner requires a valid genesis_note.bin (network_id missing)"));
            }
            if let Some(amount) = args.mint_amount {
                if amount == 0 {
                    return Err(anyhow!("--mint-amount must be > 0"));
                }
            }
            let amount_fixed = args.mint_amount;
            let lock = if let Some(l) = &args.mint_lock {
                LockCommitment(parse_hex32(l)?)
            } else {
                return Err(anyhow!("--pow-miner requires --mint-lock"));
            };
            if let Some(policy) = role_policy.as_ref() {
                if !policy.allows_mint_lock(&lock) {
                    return Err(anyhow!(
                        "role_policy forbids mint_lock {}",
                        hex::encode(lock.0)
                    ));
                }
            }
            let bits_fallback = pow_bits_eff;
            let mempool_dir_for_miner = mempool_dir.clone();
            tokio::spawn(async move {
                NODE_POW_MINING_ACTIVE.store(1, Ordering::Relaxed);
                NODE_POW_ACTIVE_LOCAL_SLOTS.store(0, Ordering::Relaxed);
                let supply_mutex = global_supply_state(&mempool_dir_for_miner);
                let mut next_nonce_start: u64 = rand::rng().random();
                let mut active_local_tip: Option<[u8; 32]> = None;
                let mut active_local_mint_id: Option<[u8; 32]> = None;
                const CHUNK_PER_THREAD: u64 = 1 << 18; // 262144 Hashes pro Thread pro Runde
                'mine_loop: loop {
                    let (chain_tip_mint_id, next_height, bits) = {
                        let supply_guard = supply_mutex.lock().await;
                        let b = if supply_guard.pow_bits > 0 { supply_guard.pow_bits } else { bits_fallback };
                        (
                            supply_guard.last_mint_id,
                            supply_guard.mint_height.saturating_add(1),
                            b,
                        )
                    };

                    let reward = if let Some(fixed) = amount_fixed {
                        fixed
                    } else {
                        pc_consensus::consts::compute_mint_reward(next_height)
                    };
                    if reward == 0 {
                        NODE_POW_MINING_ACTIVE.store(0, Ordering::Relaxed);
                        warn!("pow-miner reward is 0; mining paused");
                        tokio::time::sleep(Duration::from_secs(5)).await;
                        NODE_POW_MINING_ACTIVE.store(1, Ordering::Relaxed);
                        continue;
                    }
                    let mut mint = MintEvent {
                        version: 1,
                        prev_mint_id: chain_tip_mint_id,
                        outputs: vec![TxOut { amount: reward, lock }],
                        pow_seed: [0u8; 32],
                        pow_nonce: 0,
                        minted_at: 0,
                    };
                    let pow_seed = mint_pow_seed_v1(&network_id, &mint);
                    mint.pow_seed = pow_seed;
                    let miner_mints_dir = std::path::Path::new(&mempool_dir_for_miner).join("mints");
                    let _ = std::fs::create_dir_all(&miner_mints_dir);
                    if active_local_tip != Some(chain_tip_mint_id) {
                        if let Some(old_id) = active_local_mint_id.take() {
                            let old_path = miner_mints_dir.join(format!("{}.bin", hex::encode(old_id)));
                            let _ = std::fs::remove_file(old_path);
                            NODE_POW_ACTIVE_LOCAL_SLOTS.store(0, Ordering::Relaxed);
                        }
                        active_local_tip = Some(chain_tip_mint_id);
                    }

                    // Multi-Core Mining via Rayon: jede Runde verteilt CHUNK_PER_THREAD
                    // Nonces pro Thread. Wird wiederholt bis ein Nonce gefunden wird.
                    let found_nonce: Option<u64> = loop {
                        let base = next_nonce_start;
                        let num_threads = rayon::current_num_threads().max(1) as u64;
                        let total_iters = num_threads * CHUNK_PER_THREAD;

                        let seed_copy = pow_seed;
                        let result = tokio::task::spawn_blocking(move || {
                            use rayon::prelude::*;
                            use std::sync::atomic::{AtomicBool, AtomicU64};
                            let found_flag = AtomicBool::new(false);
                            let found_val = AtomicU64::new(0);
                            let hash_count = AtomicU64::new(0);

                            (0..num_threads).into_par_iter().for_each(|tid| {
                                let thread_base = base.wrapping_add(tid * CHUNK_PER_THREAD);
                                let mut local_count: u64 = 0;
                                for i in 0..CHUNK_PER_THREAD {
                                    if i & 4095 == 0 && found_flag.load(Ordering::Relaxed) {
                                        break;
                                    }
                                    let n = thread_base.wrapping_add(i);
                                    let h = pow_hash(&seed_copy, n);
                                    if pow_meets(bits, &h) {
                                        found_flag.store(true, Ordering::Relaxed);
                                        found_val.store(n, Ordering::Relaxed);
                                        local_count += i + 1;
                                        break;
                                    }
                                    local_count = i + 1;
                                }
                                hash_count.fetch_add(local_count, Ordering::Relaxed);
                            });

                            NODE_POW_HASHES_TOTAL.fetch_add(hash_count.load(Ordering::Relaxed), Ordering::Relaxed);
                            if found_flag.load(Ordering::Relaxed) {
                                Some(found_val.load(Ordering::Relaxed))
                            } else {
                                None
                            }
                        }).await.unwrap_or(None);

                        next_nonce_start = base.wrapping_add(total_iters);

                        if let Some(n) = result {
                            break Some(n);
                        }

                        // Prüfe ob sich der Chain-Tip geändert hat (neuer Block von anderer Quelle).
                        let current_tip = {
                            let g = supply_mutex.lock().await;
                            g.last_mint_id
                        };
                        if current_tip != chain_tip_mint_id {
                            break None;
                        }
                    };

                    let found_nonce = match found_nonce {
                        Some(n) => n,
                        None => continue 'mine_loop,
                    };

                    NODE_POW_BLOCKS_FOUND_TOTAL.fetch_add(1, Ordering::Relaxed);
                    mint.pow_nonce = found_nonce;

                    // Verwerfe Kandidat, falls sich der Chain-Tip während der Suche geändert hat.
                    let tip_unchanged = {
                        let supply_guard = supply_mutex.lock().await;
                        supply_guard.last_mint_id == chain_tip_mint_id
                    };
                    if !tip_unchanged {
                        NODE_POW_SUBMIT_STALE_TOTAL.fetch_add(1, Ordering::Relaxed);
                        continue 'mine_loop;
                    }

                    let mint_id = pc_types::digest_mint(&mint);
                    if let Some(old_id) = active_local_mint_id {
                        if old_id != mint_id {
                            let old_path = miner_mints_dir.join(format!("{}.bin", hex::encode(old_id)));
                            let _ = std::fs::remove_file(old_path);
                        }
                    }
                    let mint_path = miner_mints_dir.join(format!("{}.bin", hex::encode(mint_id)));
                    let mut buf = Vec::new();
                    if let Err(e) = mint.encode(&mut buf) {
                        NODE_POW_SUBMIT_ERR_TOTAL.fetch_add(1, Ordering::Relaxed);
                        warn!("pow-miner mint encode failed: {}", e);
                        continue 'mine_loop;
                    }
                    if let Err(e) = std::fs::write(&mint_path, &buf) {
                        NODE_POW_SUBMIT_ERR_TOTAL.fetch_add(1, Ordering::Relaxed);
                        warn!("pow-miner mint write failed: {}", e);
                        continue 'mine_loop;
                    }
                    NODE_POW_SUBMIT_OK_TOTAL.fetch_add(1, Ordering::Relaxed);
                    NODE_POW_LAST_SUBMIT_MS.store(
                        SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis() as u64,
                        Ordering::Relaxed,
                    );
                    active_local_mint_id = Some(mint_id);
                    NODE_POW_ACTIVE_LOCAL_SLOTS.store(1, Ordering::Relaxed);
                    info!(
                        height = next_height,
                        reward = reward,
                        nonce = found_nonce,
                        mint_id = %hex::encode(mint_id),
                        tip = %hex::encode(chain_tip_mint_id),
                        "pow-miner block found, mint persisted to active mints_dir slot"
                    );
                }
            });
        }

        // k_eff ist bereits vor dem Start des P2P-Services bestimmt (oben), damit Admission-Checks
        // bereits beim Persistieren greifen können.
        let _utxo_path = std::path::Path::new(&store_dir).join("utxo").to_string_lossy().to_string();
        let mempool_path = mempool_dir.clone();
        let anchor_index_path = std::path::Path::new(&store_dir).join("anchor_index").to_string_lossy().to_string();
        let payloads_signal_path = std::path::Path::new(&store_dir).join("payloads").join(".latest").to_string_lossy().to_string();
        let last_final_payload_root_path = std::path::Path::new(&store_dir)
            .join("last_final_payload_root")
            .to_string_lossy()
            .to_string();
        let state_root_path = std::path::Path::new(&store_dir)
            .join("state_root")
            .to_string_lossy()
            .to_string();
        let consensus_network_id = load_network_id_from_mempool(&mempool_path);
        if consensus_network_id.is_none() {
            warn!("genesis_note.bin fehlt; Finalitäts-Verifikation deaktiviert");
        }
        let mempool_path_cons = mempool_path.clone();

        // Dynamische Shard/K-Berechnung aus StakeRegistry (falls vorhanden).
        // Muss VOR dem Consensus-Task berechnet werden, damit k dynamisch ist.
        let initial_scale = {
            let sr_path = std::path::Path::new(&store_dir).join("stake_registry.json");
            if let Ok(json) = std::fs::read_to_string(&sr_path) {
                match pc_consensus::stake_registry::StakeRegistry::from_json_str(&json) {
                    Ok(reg) => {
                        let pool = reg.eligible_count();
                        let scale = pc_consensus::rotation_manager::compute_network_scale(pool);
                        info!(
                            pool_size = pool,
                            num_shards = scale.num_shards,
                            k = scale.k,
                            "dynamic sharding: initial scale from stake_registry"
                        );
                        scale
                    }
                    Err(e) => {
                        warn!(err = %e, "stake_registry.json parse error; fallback to genesis mode");
                        pc_consensus::rotation_manager::NetworkScale { num_shards: 1, k: k_eff }
                    }
                }
            } else {
                pc_consensus::rotation_manager::NetworkScale { num_shards: 1, k: k_eff }
            }
        };

        // Konsens-Task: beobachtet Header, pflegt Graph und markiert finale Payload-Roots
        let mut rx_in = inbound_subscribe();
        let k = initial_scale.k;
        let final_roots: Arc<tokio::sync::Mutex<FinalizedPayloadIndex>> =
            Arc::new(tokio::sync::Mutex::new(FinalizedPayloadIndex::default()));
        let finals_for_cons = final_roots.clone();
        // Interner Apply-Kandidat-Kanal für den State-Task.
        // Die Nachricht trägt den konkret final attestierten Header; materialisierte
        // Finalität wird erst nach lokaler Vollprüfung und Persistierung nach außen sichtbar.
        let (tx_apply_candidate, mut rx_apply_candidate) =
            mpsc::unbounded_channel::<FinalizedPayloadMeta>();
        let tx_apply_candidate_cons = tx_apply_candidate.clone();
        let role_policy_cons = role_policy.clone();
        let store_dir_for_consensus = store_dir.clone();
        let fsync_flag_cons = args.fsync;
        let consensus_task = tokio::spawn(async move {
            let cfg = ConsensusConfig::recommended(k);
            let mut eng = ConsensusEngine::new(cfg);
            let payload_available = |root: &[u8; 32]| -> bool {
                match FileStore::open(&store_dir_for_consensus, fsync_flag_cons) {
                    Ok(store) => match store.get_payload_v3(root) {
                        Ok(Some(p3)) => pc_types::validate_payload_sanity_v3(&p3).is_ok(),
                        Ok(None) | Err(_) => false,
                    },
                    Err(_) => false,
                }
            };
            let (rehydrated_headers, read_errors, decode_errors, digest_mismatch) =
                load_header_files_for_consensus_rehydrate(&store_dir_for_consensus);
            let rehydrated_count = rehydrated_headers.len();
            for h in rehydrated_headers {
                let hid = AnchorId(h.id_digest());
                let hv1 = pc_types::AnchorHeader {
                    version: 1,
                    shard_id: h.shard_id,
                    parents: h.parents,
                    payload_hash: h.payload_hash,
                    creator_index: h.creator_index,
                    vote_mask: h.vote_mask,
                    ack_present: h.ack_present,
                    ack_id: h.ack_id,
                };
                let _ = eng.insert_header_with_id(hid, hv1);
            }
            if read_errors > 0 || decode_errors > 0 || digest_mismatch > 0 {
                warn!(
                    rehydrated_headers = rehydrated_count,
                    read_errors,
                    decode_errors,
                    digest_mismatch,
                    "consensus rehydrate skipped invalid header files"
                );
            } else if rehydrated_count > 0 {
                info!(
                    rehydrated_headers = rehydrated_count,
                    "consensus rehydrate loaded header history"
                );
            }
            let st_boot = eng.anchor_graph_stats();
            NODE_ANCHOR_GRAPH_HEADERS.store(st_boot.headers as u64, Ordering::Relaxed);
            NODE_ANCHOR_GRAPH_ORPHANS.store(st_boot.orphans as u64, Ordering::Relaxed);
            NODE_ANCHOR_GRAPH_EVICT_TOTAL.store(st_boot.evict_total, Ordering::Relaxed);
            NODE_ANCHOR_GRAPH_ORPHAN_DROPPED_TOTAL
                .store(st_boot.orphan_dropped_total, Ordering::Relaxed);
            let finals = finals_for_cons;
            let mut committee_cache: Option<CommitteeCache> = None;
            let mut committee_recompute_last: Option<Instant> = None;
            let mut consensus_network_id = consensus_network_id;
            loop {
                match rx_in.recv().await {
                    Ok(P2pMessage::PrevoteAnnounce(h))
                    | Ok(P2pMessage::PrecommitAnnounce(h)) => {
                        // Stage A: PreVote-Header dürfen propagieren und den Graph füttern.
                        // Stage B/C: nur PreCommit-Header dürfen Finalität auslösen.
                        let is_precommit = h.state_root.is_some();
                        let header_ok = if is_precommit {
                            verify_header_finality(
                                &h,
                                k,
                                &mut consensus_network_id,
                                &mempool_path_cons,
                                &mut committee_cache,
                                &mut committee_recompute_last,
                                role_policy_cons.as_deref(),
                            )
                            .await
                        } else {
                            verify_header_prevote(
                                &h,
                                k,
                                &mut consensus_network_id,
                                &mempool_path_cons,
                                &mut committee_cache,
                                &mut committee_recompute_last,
                                role_policy_cons.as_deref(),
                            )
                            .await
                        };
                        if !header_ok {
                            warn!(root = %hex::encode(h.payload_hash), stage = if is_precommit { "precommit" } else { "prevote" }, "Header ohne gültige Committee-Attestation verworfen");
                        }
                        if is_precommit && header_ok {
                            let mut g = finals.lock().await;
                            if let Some(meta) = record_finalized_header(&mut g, &h) {
                                // DA-Gate: Payload lokal verfügbar + Hash + Sanity prüfen,
                                // bevor ein Apply-Kandidat an den State-Task weitergereicht wird.
                                // Falls Payload fehlt, übernimmt der Payload-Eingang
                                // (prüft finals_for_state und materialisiert direkt).
                                let da_ok = payload_available(&meta.root);
                                if da_ok {
                                    let _ = tx_apply_candidate_cons.send(meta);
                                } else {
                                    warn!(root = %hex::encode(meta.root), "DA-Gate: Payload nicht verfügbar – final attestierter Apply-Kandidat bleibt gepuffert bis zum Payload-Eingang");
                                }
                            }
                        }
                        // Nur verifizierte Stage-A/Stage-B Header in den in-memory Graph übernehmen.
                        if header_ok {
                            let hid = AnchorId(h.id_digest());
                            // Adapter V2->V1 für Konsens
                            let hv1 = pc_types::AnchorHeader {
                                version: 1,
                                shard_id: h.shard_id,
                                parents: h.parents.clone(),
                                payload_hash: h.payload_hash,
                                creator_index: h.creator_index,
                                vote_mask: h.vote_mask,
                                ack_present: h.ack_present,
                                ack_id: h.ack_id,
                            };
                            let _ = eng.insert_header_with_id(hid, hv1);
                            let st = eng.anchor_graph_stats();
                            NODE_ANCHOR_GRAPH_HEADERS.store(st.headers as u64, Ordering::Relaxed);
                            NODE_ANCHOR_GRAPH_ORPHANS.store(st.orphans as u64, Ordering::Relaxed);
                            NODE_ANCHOR_GRAPH_EVICT_TOTAL.store(st.evict_total, Ordering::Relaxed);
                            NODE_ANCHOR_GRAPH_ORPHAN_DROPPED_TOTAL
                                .store(st.orphan_dropped_total, Ordering::Relaxed);
                        }
                    }
                    Ok(P2pMessage::Resp(
                        RespMsg::PrevoteHeaders { headers } | RespMsg::PrecommitHeaders { headers },
                    )) => {
                        for h in headers {
                            let is_precommit = h.state_root.is_some();
                            let header_ok = if is_precommit {
                                verify_header_finality(
                                    &h,
                                    k,
                                    &mut consensus_network_id,
                                    &mempool_path_cons,
                                    &mut committee_cache,
                                    &mut committee_recompute_last,
                                    role_policy_cons.as_deref(),
                                )
                                .await
                            } else {
                                verify_header_prevote(
                                    &h,
                                    k,
                                    &mut consensus_network_id,
                                    &mempool_path_cons,
                                    &mut committee_cache,
                                    &mut committee_recompute_last,
                                    role_policy_cons.as_deref(),
                                )
                                .await
                            };
                            if !header_ok {
                                warn!(root = %hex::encode(h.payload_hash), stage = if is_precommit { "precommit" } else { "prevote" }, "Header ohne gültige Committee-Attestation verworfen");
                            }
                            if is_precommit && header_ok {
                                let mut g = finals.lock().await;
                                if let Some(meta) = record_finalized_header(&mut g, &h) {
                                    // DA-Gate: Payload lokal verfügbar + Hash + Sanity prüfen,
                                    // bevor ein Apply-Kandidat an den State-Task weitergereicht wird.
                                    // Falls Payload fehlt, übernimmt der Payload-Eingang
                                    // (prüft finals_for_state und materialisiert direkt).
                                    let da_ok = payload_available(&meta.root);
                                    if da_ok {
                                        let _ = tx_apply_candidate_cons.send(meta);
                                    } else {
                                        warn!(root = %hex::encode(meta.root), "DA-Gate: Payload nicht verfügbar – final attestierter Apply-Kandidat bleibt gepuffert bis zum Payload-Eingang");
                                    }
                                }
                            }
                            if header_ok {
                                let hid = AnchorId(h.id_digest());
                                let hv1 = pc_types::AnchorHeader {
                                    version: 1,
                                    shard_id: h.shard_id,
                                    parents: h.parents.clone(),
                                    payload_hash: h.payload_hash,
                                    creator_index: h.creator_index,
                                    vote_mask: h.vote_mask,
                                    ack_present: h.ack_present,
                                    ack_id: h.ack_id,
                                };
                                let _ = eng.insert_header_with_id(hid, hv1);
                                let st = eng.anchor_graph_stats();
                                NODE_ANCHOR_GRAPH_HEADERS.store(st.headers as u64, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_ORPHANS.store(st.orphans as u64, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_EVICT_TOTAL.store(st.evict_total, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_ORPHAN_DROPPED_TOTAL
                                    .store(st.orphan_dropped_total, Ordering::Relaxed);
                            }
                        }
                    }
                    Ok(P2pMessage::Resp(RespMsg::StagedHeaders {
                        prevote_headers,
                        precommit_headers,
                    })) => {
                        for h in prevote_headers.into_iter().chain(precommit_headers.into_iter()) {
                            let is_precommit = h.state_root.is_some();
                            let header_ok = if is_precommit {
                                verify_header_finality(
                                    &h,
                                    k,
                                    &mut consensus_network_id,
                                    &mempool_path_cons,
                                    &mut committee_cache,
                                    &mut committee_recompute_last,
                                    role_policy_cons.as_deref(),
                                )
                                .await
                            } else {
                                verify_header_prevote(
                                    &h,
                                    k,
                                    &mut consensus_network_id,
                                    &mempool_path_cons,
                                    &mut committee_cache,
                                    &mut committee_recompute_last,
                                    role_policy_cons.as_deref(),
                                )
                                .await
                            };
                            if !header_ok {
                                warn!(root = %hex::encode(h.payload_hash), stage = if is_precommit { "precommit" } else { "prevote" }, "Header ohne gültige Committee-Attestation verworfen");
                            }
                            if is_precommit && header_ok {
                                let mut g = finals.lock().await;
                                if let Some(meta) = record_finalized_header(&mut g, &h) {
                                    let da_ok = payload_available(&meta.root);
                                    if da_ok {
                                        let _ = tx_apply_candidate_cons.send(meta);
                                    } else {
                                        warn!(root = %hex::encode(meta.root), "DA-Gate: Payload nicht verfügbar – final attestierter Apply-Kandidat bleibt gepuffert bis zum Payload-Eingang");
                                    }
                                }
                            }
                            if header_ok {
                                let hid = AnchorId(h.id_digest());
                                let hv1 = pc_types::AnchorHeader {
                                    version: 1,
                                    shard_id: h.shard_id,
                                    parents: h.parents.clone(),
                                    payload_hash: h.payload_hash,
                                    creator_index: h.creator_index,
                                    vote_mask: h.vote_mask,
                                    ack_present: h.ack_present,
                                    ack_id: h.ack_id,
                                };
                                let _ = eng.insert_header_with_id(hid, hv1);
                                let st = eng.anchor_graph_stats();
                                NODE_ANCHOR_GRAPH_HEADERS.store(st.headers as u64, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_ORPHANS.store(st.orphans as u64, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_EVICT_TOTAL.store(st.evict_total, Ordering::Relaxed);
                                NODE_ANCHOR_GRAPH_ORPHAN_DROPPED_TOTAL
                                    .store(st.orphan_dropped_total, Ordering::Relaxed);
                            }
                        }
                    }
                    Ok(_) => {}
                    Err(tokio::sync::broadcast::error::RecvError::Lagged(n)) => { NODE_INBOUND_OBS_LAGGED_TOTAL.fetch_add(n, Ordering::Relaxed); continue; }
                    Err(tokio::sync::broadcast::error::RecvError::Closed) => { break; }
                }
            }
            Ok::<(), anyhow::Error>(())
        });

        // State-Task: beobachtet Payload-/Tx-Responses und aktualisiert den UTXO-State deterministisch
        let mut rx_state = inbound_subscribe();
        let finals_for_state = final_roots.clone();
        // mpsc Receiver für Finalisierungen
        // Tx-Proposer Parameter: dynamisch über Validator-Control
        let proposer_enabled = proposer_enabled.clone();
        let proposer_interval_ms = args.tx_proposer_interval_ms;
        let proposer_cap_raw = args
            .txs_per_payload
            .or_else(|| {
                load_genesis_note_from_mempool(&mempool_path)
                    .map(|n| n.params.txs_per_payload as usize)
            })
            .unwrap_or(consts::DEFAULT_TXS_PER_PAYLOAD);
        if proposer_cap_raw > MAX_PAYLOAD_MICROTX {
            warn!(
                proposer_cap_raw,
                max_allowed = MAX_PAYLOAD_MICROTX,
                "txs_per_payload exceeds MAX_PAYLOAD_MICROTX; clamping"
            );
        }
        let proposer_cap = proposer_cap_raw.min(MAX_PAYLOAD_MICROTX);
        let svc_prop = svc.clone();
        let tx_b_prop = tx_broadcast.clone();
        let fsync_flag = args.fsync;
	        let payload_budget = args.payload_budget_bytes;
	        let pow_bits_init = pow_bits_eff;
	        let store_dir_for_warn = store_dir.clone();
	        let k_state = k_eff;

            // Open the primary UTXO DB before spawning tasks so we can fail fast with a proper error
            // instead of panicking inside the task on startup.
            #[cfg(feature = "rocksdb")]
            let st_backend = {
                let _ = std::fs::create_dir_all(&_utxo_path);
                open_rocksdb_primary_with_recovery(&_utxo_path, "utxo")?
            };
	        let local_validator_id_for_proposer = validator_id;
	        let state_task = tokio::spawn(async move {
            #[cfg(feature = "rocksdb")]
            let mut st = UtxoState::new(st_backend);
            #[cfg(not(feature = "rocksdb"))]
            let mut st = UtxoState::new(InMemoryBackend::new());
            // globaler Anchor-Index für Maturity (uhrfrei, zählt final angewandte Payloads)
            let mut anchor_index: AnchorIndex = match std::fs::read_to_string(&anchor_index_path) {
                Ok(s) => s.trim().parse::<u64>().unwrap_or(0),
                Err(_) => 0,
            };
            NODE_ANCHOR_INDEX.store(anchor_index, Ordering::Relaxed);
            // Idempotence is tracked by finalized header id, not payload root: identical
            // heartbeat/no-decision payloads may legitimately recur at later anchors.
            let mut applied_final_headers: HashSet<[u8; 32]> = HashSet::new();
            let mut applied_final_headers_order: VecDeque<[u8; 32]> = VecDeque::new();
            const APPLIED_FINAL_HEADERS_CAP: usize = 100_000;
            let mut finalized_queue: FinalizedQueue<FinalizedPayloadMeta> = FinalizedQueue::new();
            let num_shards_state: u16 = initial_scale.num_shards;
            // Shards, für die dieser Node zuständig ist.
            // Initial: Shard 0 (Genesis-Modus / Fullnode).
            // Bei Epoch-Rotation wird das Set via get_active_shards_for_validator aktualisiert.
            let my_shard_ids: std::collections::HashSet<u16> = {
                let mut s = std::collections::HashSet::new();
                s.insert(0);
                s
            };
	            let network_id: [u8; 32] =
	                load_network_id_from_mempool(&mempool_path).unwrap_or([0u8; 32]);
	            let mut slash_committee_cache: Option<CommitteeCache> = None;
                let mut mint_censor_runtime: Option<MintCensorRuntimeV1> = None;
                if mint_censor_feature_enabled(&mempool_path) {
                    if network_id == [0u8; 32] {
                        error!(
                            "mint-censor-v1 enabled but network_id is missing (genesis_note.bin not available/invalid)"
                        );
                        return Ok::<(), anyhow::Error>(());
                    }
                    let genesis_features = load_genesis_features_from_mempool(&mempool_path)
                        .unwrap_or_default();
                    let forced_inclusion_v2_enabled = mint_forced_inclusion_v2_enabled(&mempool_path);
                    let params = default_mint_censor_params_v1(
                        network_id,
                        pow_bits_init,
                        genesis_features,
                    );
                    let rt_init = if forced_inclusion_v2_enabled {
                        MintCensorRuntimeV1::new_with_forced_inclusion_v2(params, true)
                    } else {
                        MintCensorRuntimeV1::new(params)
                    };
                    match rt_init {
                        Ok(rt) => {
                            mint_censor_runtime = Some(rt);
                            if forced_inclusion_v2_enabled {
                                info!("mint-censor-v1 runtime enabled (+ forced-inclusion-v2)");
                            } else {
                                info!("mint-censor-v1 runtime enabled");
                            }
                        }
                        Err(e) => {
                            error!(
                                err = %e,
                                "mint-censor-v1 enabled but params are invalid; aborting state task"
                            );
                            return Ok::<(), anyhow::Error>(());
                        }
                    }
                }

                // Bootstrap finalized_anchor_ids from persisted state so the proposer
                // can make mint decisions immediately after restart instead of being
                // stuck in a chicken-and-egg loop (no payloads → no finalization →
                // no anchor ids → no mint decision → no payloads).
                if let Some(rt) = mint_censor_runtime.as_mut() {
                    let seed_root = committee_seed_anchor_from_mempool(&mempool_path)
                        .unwrap_or_else(|| {
                            load_genesis_note_from_mempool(&mempool_path)
                                .map(|n| pc_types::genesis_payload_root(&n))
                                .unwrap_or([0u8; 32])
                        });
                    if seed_root != [0u8; 32] {
                        let seeded =
                            bootstrap_seed_finalized_anchor_ids(rt, anchor_index, seed_root);
                        info!(
                            anchor_index = anchor_index,
                            seeded = seeded,
                            seed_root = %hex::encode(seed_root),
                            "mint-censor bootstrap: seeded finalized_anchor_ids from persisted state"
                        );
                    }
                }

            // Seed anchor persistence: make sure we have an initial last_final_payload_root
            // (genesis payload root) even before the first finalized payload is applied.
            if !std::path::Path::new(&last_final_payload_root_path).exists() {
                let gen_root = load_genesis_note_from_mempool(&mempool_path)
                    .map(|note| pc_types::genesis_payload_root(&note))
                    .unwrap_or([0u8; 32]);
                let _ = atomic_write_async(
                    std::path::Path::new(&last_final_payload_root_path),
                    format!("{}\n", hex::encode(gen_root)).into_bytes(),
                    fsync_flag,
                )
                .await;
            }
            let supply_mutex = global_supply_state(&mempool_path);
            {
                let mut supply_guard = supply_mutex.lock().await;
                let init_bits = consts::pow_bits_for_mint_height(pow_bits_init, 1);
                if supply_guard.mint_height == 0
                    && supply_guard.total_supply == 0
                    && supply_guard.last_mint_id == [0u8; 32]
                    && supply_guard.last_minted_at_index == 0
                {
                    let mut dirty = false;
                    if supply_guard.pow_bits != init_bits {
                        supply_guard.pow_bits = init_bits;
                        dirty = true;
                    }
                    if supply_guard.pow_bits_min != init_bits {
                        supply_guard.pow_bits_min = init_bits;
                        dirty = true;
                    }
                    if dirty {
                        persist_supply_state_sync(&mempool_path, &supply_guard, fsync_flag);
                    }
                } else {
                    // Backward-compat: older supply_state.json may not have pow_bits_min.
                    // Use the configured init bits as powLimit (Bitcoin-style floor).
                    let mut dirty = false;
                    if supply_guard.pow_bits_min == 0 && init_bits != 0 {
                        supply_guard.pow_bits_min = init_bits;
                        dirty = true;
                    }
                    if supply_guard.pow_bits < supply_guard.pow_bits_min {
                        supply_guard.pow_bits = supply_guard.pow_bits_min;
                        dirty = true;
                    }
                    if dirty {
                        persist_supply_state_sync(&mempool_path, &supply_guard, fsync_flag);
                    }
                }
            }
            let mut mempool: HashMap<[u8;32], (MicroTx, Instant)> = HashMap::new();
            let mut mempool_order: VecDeque<[u8;32]> = VecDeque::new();
            // Mempool input overlay: prevents accepting conflicting txs (double-spends) into the mempool.
            // Mempool-Overlay: verhindert Konflikt-TXs (Double-Spends) im Mempool.
            let mut mempool_spent: HashMap<OutPoint, [u8;32]> = HashMap::new();
            const MEMPOOL_GLOBAL_MAX: usize = 65_536;
            #[inline]
            fn mempool_cap_per_shard(num_shards: u16) -> usize {
                let s = (num_shards as usize).max(1);
                (MEMPOOL_GLOBAL_MAX / s).max(512)
            }
            let mempool_cap = mempool_cap_per_shard(num_shards_state);
            const MEMPOOL_TTL_SECS: u64 = 3600; // 1h
            let _ = std::fs::create_dir_all(&mempool_path);
            let journal_path = std::path::Path::new(&mempool_path).join("mempool.journal");
            // Bootstrap: Recovery via Journal (falls vorhanden), sonst Verzeichnis lesen
            let mut active_ids: Option<std::collections::HashSet<[u8;32]>> = None;
            if let Ok(Some((set, fmt))) = journal_read_active_ids(&journal_path) {
                // Best-effort one-time migration: legacy line-based journal -> binary v1.
                if fmt == JournalFormat::LegacyText {
                    let mut ids: Vec<[u8; 32]> = set.iter().copied().collect();
                    ids.sort();
                    let _ = journal_rewrite_binary_v1(&journal_path, ids, fsync_flag);
                }
                active_ids = Some(set);
            }
            if let Some(ids) = active_ids {
                // Lade nur IDs aus Journal
                for id in ids.iter() {
                    let id = *id;
                    let fname = format!("{}.bin", hex::encode(id));
                    let p = std::path::Path::new(&mempool_path).join(fname);
                    if let Ok(mut f) = std::fs::File::open(&p) {
                        let mut buf = Vec::new();
                        use std::io::Read as _;
                        if f.read_to_end(&mut buf).is_ok() {
                            if let Ok(tx) = pc_codec::decode_exact::<MicroTx>(&buf) {
                                // Ensure file contents match expected id.
                                // Sicherstellen, dass Dateiinhalt zur ID passt.
                                let got = digest_microtx(&tx);
                                if got != id {
                                    let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                    let _ = remove_with_dir_sync(&p, fsync_flag);
                                    continue;
                                }

                                if validate_microtx_sanity(&tx).is_ok()
                                    && st.can_apply_micro_tx(&tx, &network_id).is_ok()
                                {
                                    // Shard filter.
                                    if !my_shard_ids.contains(&shard_for_tx(&tx, num_shards_state)) {
                                        NODE_MEMPOOL_SHARD_REJECT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                        let _ = remove_with_dir_sync(&p, fsync_flag);
                                        continue;
                                    }
                                    // Mempool conflict check (overlay).
                                    let mut conflict = false;
                                    for tin in &tx.inputs {
                                        if mempool_spent.contains_key(&tin.prev_out) {
                                            conflict = true;
                                            break;
                                        }
                                    }
                                    if conflict {
                                        NODE_MEMPOOL_CONFLICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                        let _ = remove_with_dir_sync(&p, fsync_flag);
                                        continue;
                                    }
                                    for tin in &tx.inputs {
                                        let _ = mempool_spent.insert(tin.prev_out, id);
                                    }
                                    let _ = mempool.insert(id, (tx, Instant::now()));
                                    mempool_order.push_back(id);
                                } else {
                                    NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                    let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                    let _ = remove_with_dir_sync(&p, fsync_flag);
                                }
                            }
                        }
                    }
                }
                NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
            } else if let Ok(rd) = std::fs::read_dir(&mempool_path) {
                // Fallback: Verzeichnis
                let mut files: Vec<std::path::PathBuf> = rd.flatten().map(|e| e.path()).filter(|p| p.is_file()).collect();
                files.sort();
                for p in files {
                    // Only consider mempool tx files: <64hex>.bin
                    let fname = match p.file_name().and_then(|s| s.to_str()) {
                        Some(s) => s,
                        None => continue,
                    };
                    if !fname.ends_with(".bin") {
                        continue;
                    }
                    let stem = fname.trim_end_matches(".bin");
                    if stem.len() != 64 {
                        continue;
                    }
                    let raw = match hex::decode(stem) {
                        Ok(b) if b.len() == 32 => b,
                        _ => continue,
                    };
                    let mut id_from_name = [0u8; 32];
                    id_from_name.copy_from_slice(&raw);

                    if let Ok(mut f) = std::fs::File::open(&p) {
                        let mut buf = Vec::new();
                        use std::io::Read as _;
                        if f.read_to_end(&mut buf).is_ok() {
                            if let Ok(tx) = pc_codec::decode_exact::<MicroTx>(&buf) {
                                let id = digest_microtx(&tx);
                                // Ensure file name matches tx digest (best-effort cleanup).
                                if id != id_from_name {
                                    let _ = journal_append(&journal_path, fsync_flag, b'D', &id_from_name);
                                    let _ = remove_with_dir_sync(&p, fsync_flag);
                                    continue;
                                }

                                if validate_microtx_sanity(&tx).is_ok()
                                    && st.can_apply_micro_tx(&tx, &network_id).is_ok()
                                {
                                    // Shard filter.
                                    if !my_shard_ids.contains(&shard_for_tx(&tx, num_shards_state)) {
                                        NODE_MEMPOOL_SHARD_REJECT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                        let _ = remove_with_dir_sync(&p, fsync_flag);
                                        continue;
                                    }
                                    let mut conflict = false;
                                    for tin in &tx.inputs {
                                        if mempool_spent.contains_key(&tin.prev_out) {
                                            conflict = true;
                                            break;
                                        }
                                    }
                                    if conflict {
                                        NODE_MEMPOOL_CONFLICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                        let _ = remove_with_dir_sync(&p, fsync_flag);
                                        continue;
                                    }
                                    for tin in &tx.inputs {
                                        let _ = mempool_spent.insert(tin.prev_out, id);
                                    }
                                    let _ = mempool.insert(id, (tx, Instant::now()));
                                    mempool_order.push_back(id);
                                } else {
                                    NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                    let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                    let _ = remove_with_dir_sync(&p, fsync_flag);
                                }
                            } else {
                                // Failed to decode: remove the tx file (name indicates it's a mempool tx).
                                NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                let _ = journal_append(&journal_path, fsync_flag, b'D', &id_from_name);
                                let _ = remove_with_dir_sync(&p, fsync_flag);
                            }
                        }
                    }
                }
                NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
            }

            // Evidence pool: on-chain evidence objects (e.g. slashing evidence / tickets).
            // Stored as pc-codec EvidenceEvent binaries in `mempool/evidences/<id>.bin` with a small journal.
            let mut evidence_pool: HashMap<[u8;32], (EvidenceEvent, Instant)> = HashMap::new();
            let mut evidence_order: VecDeque<[u8;32]> = VecDeque::new();
            const EVIDENCE_MAX: usize = 8192;
            const EVIDENCE_TTL_SECS: u64 = 6 * 3600; // 6h
            let evidences_dir = std::path::Path::new(&mempool_path).join("evidences");
            let _ = std::fs::create_dir_all(&evidences_dir);
            let evidence_journal_path = std::path::Path::new(&mempool_path).join("evidences.journal");
            let wallet_history_journal_path =
                std::path::Path::new(&mempool_path).join("wallet_history.v1.jsonl");

            // Bootstrap: Recovery via evidence journal (if present), otherwise directory scan.
            let mut active_evid_ids: Option<std::collections::HashSet<[u8;32]>> = None;
            if let Ok(Some((set, fmt))) = journal_read_active_ids(&evidence_journal_path) {
                // Best-effort one-time migration: legacy line-based journal -> binary v1.
                if fmt == JournalFormat::LegacyText {
                    let mut ids: Vec<[u8; 32]> = set.iter().copied().collect();
                    ids.sort();
                    let _ = journal_rewrite_binary_v1(&evidence_journal_path, ids, fsync_flag);
                }
                active_evid_ids = Some(set);
            }
            if let Some(ids) = active_evid_ids {
                for id in ids.iter() {
                    let id = *id;
                    let fname = format!("{}.bin", hex::encode(id));
                    let p = evidences_dir.join(fname);
                    let buf = match std::fs::read(&p) {
                        Ok(b) => b,
                        Err(_) => continue,
                    };
                    let evid = match pc_codec::decode_exact::<EvidenceEvent>(&buf) {
                        Ok(e) => e,
                        Err(_) => {
                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                            let _ = remove_with_dir_sync(&p, fsync_flag);
                            continue;
                        }
                    };
                    let got = pc_types::digest_evidence(&evid);
                    if got != id {
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    if pc_types::validate_evidence_sanity(&evid).is_err() {
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    if let Err(reason) =
                        mint_censor_evidence_ingest_allowed(&evid, mint_censor_runtime.as_ref())
                    {
                        if should_log_bootstrap_evidence_drop(reason) {
                            warn!(
                                evidence_id = %hex::encode(id),
                                reason,
                                "drop evidence during bootstrap ingest"
                            );
                        }
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    let _ = evidence_pool.insert(id, (evid, Instant::now()));
                    evidence_order.push_back(id);
                }
            } else if let Ok(rd) = std::fs::read_dir(&evidences_dir) {
                let mut files: Vec<std::path::PathBuf> = rd.flatten().map(|e| e.path()).filter(|p| p.is_file()).collect();
                files.sort();
                for p in files {
                    let fname = match p.file_name().and_then(|s| s.to_str()) {
                        Some(s) => s,
                        None => continue,
                    };
                    if !fname.ends_with(".bin") {
                        continue;
                    }
                    let stem = fname.trim_end_matches(".bin");
                    if stem.len() != 64 {
                        continue;
                    }
                    let raw = match hex::decode(stem) {
                        Ok(b) if b.len() == 32 => b,
                        _ => continue,
                    };
                    let mut id_from_name = [0u8; 32];
                    id_from_name.copy_from_slice(&raw);
                    let buf = match std::fs::read(&p) {
                        Ok(b) => b,
                        Err(_) => continue,
                    };
                    let evid = match pc_codec::decode_exact::<EvidenceEvent>(&buf) {
                        Ok(e) => e,
                        Err(_) => {
                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id_from_name);
                            let _ = remove_with_dir_sync(&p, fsync_flag);
                            continue;
                        }
                    };
                    let id = pc_types::digest_evidence(&evid);
                    if id != id_from_name {
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id_from_name);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    if pc_types::validate_evidence_sanity(&evid).is_err() {
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    if let Err(reason) =
                        mint_censor_evidence_ingest_allowed(&evid, mint_censor_runtime.as_ref())
                    {
                        if should_log_bootstrap_evidence_drop(reason) {
                            warn!(
                                evidence_id = %hex::encode(id),
                                reason,
                                "drop evidence during bootstrap ingest"
                            );
                        }
                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                        let _ = remove_with_dir_sync(&p, fsync_flag);
                        continue;
                    }
                    let _ = evidence_pool.insert(id, (evid, Instant::now()));
                    evidence_order.push_back(id);
                }
            }

            // Pending-Queue Limits
            const PENDING_MAX: usize = 8192; // Obergrenze für gepufferte Payloads
            const PENDING_TTL_SECS: u64 = 600; // 10 Minuten TTL
            let mut pending: HashMap<[u8;32], (pc_types::AnchorPayloadV3, Instant)> = HashMap::new();
            let mut order: VecDeque<[u8;32]> = VecDeque::new();
            let mut tick = interval(Duration::from_secs(30));
            // Add a small random jitter so validators don't propose in lockstep after a coordinated
            // (re)start. This avoids periodic bursts and reduces collision risk.
            let prop_period = Duration::from_millis(proposer_interval_ms.max(1));
            let prop_jitter_ms: u64 = {
                let mut rng = rand::rng();
                rng.random_range(0..=500)
            };
            let prop_start = tokio::time::Instant::now() + Duration::from_millis(prop_jitter_ms);
            let mut prop_tick = tokio::time::interval_at(prop_start, prop_period);
            // Ingest transactions appended by other local processes via mempool.journal (e.g. status_http /tx/broadcast).
            // This makes local HTTP broadcast work without requiring the runtime to directly expose HTTP endpoints.
            let mut mempool_journal_tick = interval(Duration::from_millis(500));
            let mut mempool_journal_offset: u64 = 0;
            let mut mempool_journal_buf: Vec<u8> = Vec::new();
            // Ingest evidences appended by other local processes via evidences.journal (e.g. status_http /evidence/broadcast).
            let mut evidence_journal_tick = interval(Duration::from_millis(500));
            let mut evidence_journal_offset: u64 = 0;
            let mut evidence_journal_buf: Vec<u8> = Vec::new();
            let mints_dir = std::path::Path::new(&mempool_path).join("mints");
            let _ = std::fs::create_dir_all(&mints_dir);
            let mut mint_tick = interval(Duration::from_secs(2));
            let mint_rpc_marker = std::path::Path::new(&mempool_path).join("mint_rpc.marker.json");
            let mut mint_rpc_tick = interval(Duration::from_secs(60));
            let mut mint_rpc_warn_at: Option<Instant> = None;
            let mut seen_mints: HashSet<[u8;32]> = HashSet::new();
            #[derive(Clone, Copy)]
            struct EmittedWorkState {
                candidate_id: [u8; 32],
                candidate_pow_hash: [u8; 32],
                mint_commitment: [u8; 32],
                candidate_evidence_id: [u8; 32],
                pow_cert_evidence_id: Option<[u8; 32]>,
            }

            let mut known_mints: HashMap<[u8; 32], MintEvent> = HashMap::new();
            let mut candidate_nonce_cursor: HashMap<[u8; 32], u64> = HashMap::new();
            let mut emitted_candidate_work: HashMap<[u8; 32], EmittedWorkState> = HashMap::new();
            let mut active_candidate_scope: Option<([u8; 32], u64)> = None;
            NODE_POW_CANDIDATE_ACTIVE_WORK_SLOTS.store(0, Ordering::Relaxed);
            const CANDIDATE_NONCE_ITERS_PER_TICK: u64 = 200_000;
            loop {
                tokio::select! {
                    _ = mempool_journal_tick.tick() => {
                        // Best-effort journal tailing. Robust against periodic journal rewrites (compaction).
                        // Best-effort Journal-Tailing. Robust gegen periodische Journal-Rewrites (Komprimierung).
                        if let Ok(meta) = std::fs::metadata(&journal_path) {
                            let len = meta.len();
                            if len < mempool_journal_offset {
                                // Journal was rewritten/truncated: restart from the beginning.
                                mempool_journal_offset = 0;
                                mempool_journal_buf.clear();
                            }
                            if len > mempool_journal_offset {
                                use std::io::{Read as _, Seek as _};
                                if let Ok(mut f) = std::fs::File::open(&journal_path) {
                                    if f.seek(std::io::SeekFrom::Start(mempool_journal_offset)).is_ok() {
                                        let mut tmp: Vec<u8> =
                                            Vec::with_capacity((len - mempool_journal_offset) as usize);
                                        if f.read_to_end(&mut tmp).is_ok() && !tmp.is_empty() {
                                            mempool_journal_offset =
                                                mempool_journal_offset.saturating_add(tmp.len() as u64);
                                            mempool_journal_buf.extend_from_slice(&tmp);
                                            let mut start: usize = 0;
                                            while let Some(rel) = mempool_journal_buf
                                                .get(start..)
                                                .and_then(|tail| tail.iter().position(|b| *b == b'\n'))
                                            {
                                                let end = start + rel;
                                                let line = match mempool_journal_buf.get(start..end) {
                                                    Some(l) => l,
                                                    None => break,
                                                };
                                                start = end + 1;
                                                if line.len() < 65 {
                                                    continue;
                                                }
                                                let op = match line.first() {
                                                    Some(b) => *b,
                                                    None => continue,
                                                };
                                                if op != b'A' && op != b'D' {
                                                    continue;
                                                }
                                                let hexid = match line.get(1..65) {
                                                    Some(h) => h,
                                                    None => continue,
                                                };
                                                let raw = match hex::decode(hexid) {
                                                    Ok(v) => v,
                                                    Err(_) => continue,
                                                };
                                                if raw.len() != 32 {
                                                    continue;
                                                }
                                                let mut id = [0u8; 32];
                                                id.copy_from_slice(&raw);

                                                match op {
                                                    b'A' => {
                                                        if mempool.contains_key(&id) {
                                                            continue;
                                                        }
                                                        // Load tx from disk.
                                                        let fname = format!("{}.bin", hex::encode(id));
                                                        let path = std::path::Path::new(&mempool_path).join(fname);
                                                        let buf = match std::fs::read(&path) {
                                                            Ok(b) => b,
                                                            Err(_) => continue,
                                                        };
                                                        let tx = match pc_codec::decode_exact::<MicroTx>(&buf) {
                                                            Ok(t) => t,
                                                            Err(_) => {
                                                                NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                                let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                                                let _ = remove_with_dir_sync(&path, fsync_flag);
                                                                continue;
                                                            }
                                                        };
                                                        if validate_microtx_sanity(&tx).is_err() {
                                                            NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                            let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }
                                                        // Shard filter.
                                                        if !my_shard_ids.contains(&shard_for_tx(&tx, num_shards_state)) {
                                                            NODE_MEMPOOL_SHARD_REJECT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                            let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }
                                                        // Reject conflicts against current mempool overlay.
                                                        let mut conflict = false;
                                                        for tin in &tx.inputs {
                                                            if mempool_spent.contains_key(&tin.prev_out) {
                                                                conflict = true;
                                                                break;
                                                            }
                                                        }
                                                        if conflict {
                                                            NODE_MEMPOOL_CONFLICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                            let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }
                                                        // Stateful check against current UTXO state.
                                                        if st.can_apply_micro_tx(&tx, &network_id).is_err() {
                                                            NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                            let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }

                                                        // Cap eviction (same as P2P admission).
                                                        if mempool.len() >= mempool_cap {
                                                            if let Some(old_id) = mempool_order.pop_front() {
                                                                if let Some((old_tx, _ts)) = mempool.remove(&old_id) {
                                                                    for tin in &old_tx.inputs {
                                                                        if mempool_spent.get(&tin.prev_out) == Some(&old_id) {
                                                                            mempool_spent.remove(&tin.prev_out);
                                                                        }
                                                                    }
                                                                }
                                                                let old_fname = format!("{}.bin", hex::encode(old_id));
                                                                let old_path = std::path::Path::new(&mempool_path)
                                                                    .join(old_fname);
                                                                let _ = journal_append(&journal_path, fsync_flag, b'D', &old_id);
                                                                let _ = remove_with_dir_sync(&old_path, fsync_flag);
                                                                NODE_MEMPOOL_CAP_EVICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                            }
                                                        }

                                                        for tin in &tx.inputs {
                                                            let _ = mempool_spent.insert(tin.prev_out, id);
                                                        }
                                                        let _ = mempool.insert(id, (tx, Instant::now()));
                                                        mempool_order.push_back(id);
                                                        NODE_MEMPOOL_ACCEPTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                                        NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
                                                    }
                                                    b'D' => {
                                                        if let Some((old_tx, _ts)) = mempool.remove(&id) {
                                                            for tin in &old_tx.inputs {
                                                                if mempool_spent.get(&tin.prev_out) == Some(&id) {
                                                                    mempool_spent.remove(&tin.prev_out);
                                                                }
                                                            }
                                                            if let Some(pos) = mempool_order.iter().position(|k| *k == id) {
                                                                let _ = mempool_order.remove(pos);
                                                            }
                                                            NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
                                                        }
                                                    }
                                                    _ => {}
                                                }
                                            }
                                            if start > 0 {
                                                // Drop processed lines; keep an incomplete tail (if any).
                                                mempool_journal_buf.drain(0..start);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    _ = evidence_journal_tick.tick() => {
                        // Best-effort evidence journal tailing (similar to mempool.journal).
                        if let Ok(meta) = std::fs::metadata(&evidence_journal_path) {
                            let len = meta.len();
                            if len < evidence_journal_offset {
                                evidence_journal_offset = 0;
                                evidence_journal_buf.clear();
                            }
                            if len > evidence_journal_offset {
                                use std::io::{Read as _, Seek as _};
                                if let Ok(mut f) = std::fs::File::open(&evidence_journal_path) {
                                    if f.seek(std::io::SeekFrom::Start(evidence_journal_offset)).is_ok() {
                                        let mut tmp: Vec<u8> =
                                            Vec::with_capacity((len - evidence_journal_offset) as usize);
                                        if f.read_to_end(&mut tmp).is_ok() && !tmp.is_empty() {
                                            evidence_journal_offset =
                                                evidence_journal_offset.saturating_add(tmp.len() as u64);
                                            evidence_journal_buf.extend_from_slice(&tmp);
                                            let mut start: usize = 0;
                                            while let Some(rel) = evidence_journal_buf
                                                .get(start..)
                                                .and_then(|tail| tail.iter().position(|b| *b == b'\n'))
                                            {
                                                let end = start + rel;
                                                let line = match evidence_journal_buf.get(start..end) {
                                                    Some(l) => l,
                                                    None => break,
                                                };
                                                start = end + 1;
                                                if line.len() < 65 {
                                                    continue;
                                                }
                                                let op = match line.first() {
                                                    Some(b) => *b,
                                                    None => continue,
                                                };
                                                if op != b'A' && op != b'D' {
                                                    continue;
                                                }
                                                let hexid = match line.get(1..65) {
                                                    Some(h) => h,
                                                    None => continue,
                                                };
                                                let raw = match hex::decode(hexid) {
                                                    Ok(v) => v,
                                                    Err(_) => continue,
                                                };
                                                if raw.len() != 32 {
                                                    continue;
                                                }
                                                let mut id = [0u8; 32];
                                                id.copy_from_slice(&raw);

                                                match op {
                                                    b'A' => {
                                                        if evidence_pool.contains_key(&id) {
                                                            continue;
                                                        }
                                                        let fname = format!("{}.bin", hex::encode(id));
                                                        let path = evidences_dir.join(fname);
                                                        let buf = match std::fs::read(&path) {
                                                            Ok(b) => b,
                                                            Err(_) => continue,
                                                        };
                                                        let evid = match pc_codec::decode_exact::<EvidenceEvent>(&buf) {
                                                            Ok(e) => e,
                                                            Err(_) => {
                                                                let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                                                                let _ = remove_with_dir_sync(&path, fsync_flag);
                                                                continue;
                                                            }
                                                        };
                                                        let got = pc_types::digest_evidence(&evid);
                                                        if got != id {
                                                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }
                                                        if pc_types::validate_evidence_sanity(&evid).is_err() {
                                                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                                            continue;
                                                        }
                                                        if let Err(reason) = mint_censor_evidence_ingest_allowed(
                                                            &evid,
                                                            mint_censor_runtime.as_ref(),
                                                        ) {
                                                            warn!(
                                                                evidence_id = %hex::encode(id),
                                                                reason,
                                                                "drop evidence during journal ingest"
                                                            );
                                                            let _ = journal_append(
                                                                &evidence_journal_path,
                                                                fsync_flag,
                                                                b'D',
                                                                &id,
                                                            );
                                                            let _ = remove_with_dir_sync(
                                                                &path, fsync_flag,
                                                            );
                                                            continue;
                                                        }

                                                        // Cap eviction: evict oldest evidence.
                                                        if evidence_pool.len() >= EVIDENCE_MAX {
                                                            if let Some(old_id) = evidence_order.pop_front() {
                                                                let _ = evidence_pool.remove(&old_id);
                                                                let old_fname = format!("{}.bin", hex::encode(old_id));
                                                                let old_path = evidences_dir.join(old_fname);
                                                                let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &old_id);
                                                                let _ = remove_with_dir_sync(&old_path, fsync_flag);
                                                            }
                                                        }

                                                        // Gossip evidence after local acceptance so it can reach proposers
                                                        // even if the reporter is a fullnode (non-proposer).
                                                        let evid_for_gossip = evid.clone();
                                                        let _ = evidence_pool.insert(id, (evid, Instant::now()));
                                                        evidence_order.push_back(id);
                                                        let _ = svc_prop.put_evidence(evid_for_gossip).await;
                                                    }
                                                    b'D' => {
                                                        if evidence_pool.remove(&id).is_some() {
                                                            if let Some(pos) = evidence_order.iter().position(|k| *k == id) {
                                                                let _ = evidence_order.remove(pos);
                                                            }
                                                        }
                                                    }
                                                    _ => {}
                                                }
                                            }
                                            if start > 0 {
                                                evidence_journal_buf.drain(0..start);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    _ = mint_rpc_tick.tick() => {
                        let warn_due = mint_rpc_warn_at
                            .map(|t| t.elapsed() > Duration::from_secs(600))
                            .unwrap_or(true);
                        if let Ok(raw) = std::fs::read_to_string(&mint_rpc_marker) {
                            if let Ok(v) = serde_json::from_str::<serde_json::Value>(&raw) {
                                if let Some(sd) = v.get("store_dir").and_then(|v| v.as_str()) {
                                    if sd != store_dir_for_warn && warn_due {
                                        warn!(
                                            marker = %mint_rpc_marker.display(),
                                            store_dir_node = %store_dir_for_warn,
                                            store_dir_mint_rpc = %sd,
                                            "mint_rpc store_dir weicht ab; Mint-Propagation kann fehlschlagen"
                                        );
                                        mint_rpc_warn_at = Some(Instant::now());
                                    } else {
                                        mint_rpc_warn_at = None;
                                    }
                                }
                            }
                        } else if warn_due {
                            warn!(
                                marker = %mint_rpc_marker.display(),
                                expected_store_dir = %store_dir_for_warn,
                                expected_mempool = %mempool_path,
                                "kein mint_rpc marker gefunden; falls mint_rpc läuft, nutze --store-dir (oder --mempool-dir) passend zum Node"
                            );
                            mint_rpc_warn_at = Some(Instant::now());
                        }
                    }
	                    _ = mint_tick.tick() => {
	                        let mut candidates: Vec<([u8;32], std::path::PathBuf)> = Vec::new();
	                        if let Ok(rd) = std::fs::read_dir(&mints_dir) {
	                            for ent in rd.flatten() {
	                                let path = ent.path();
                                if !path.is_file() { continue; }
                                let fname = match path.file_name().and_then(|s| s.to_str()) {
                                    Some(s) => s,
                                    None => continue,
                                };
                                if !fname.ends_with(".bin") { continue; }
                                let hexid = fname.trim_end_matches(".bin");
                                if hexid.len() != 64 { continue; }
                                let bytes = match hex::decode(hexid) {
                                    Ok(b) if b.len() == 32 => b,
                                    _ => continue,
                                };
                                let mut id = [0u8;32];
                                id.copy_from_slice(&bytes);
                                if mint_censor_runtime.is_none() && seen_mints.contains(&id) {
                                    continue;
                                }
                                candidates.push((id, path));
                            }
                        }

	                        const MINT_TICK_BATCH_LIMIT: usize = 8;
	                        let mut mint_tick_processed = 0usize;
	                        for (id, path) in candidates {
	                            if mint_tick_processed >= MINT_TICK_BATCH_LIMIT {
	                                break;
	                            }
	                            // Datei-Größe prüfen (Schutz vor Missbrauch)
	                            if let Ok(meta) = std::fs::metadata(&path) {
	                                if meta.len() as usize > MAX_HTTP_BODY_BYTES {
	                                    warn!(file = %path.display(), "mint file too large, drop");
	                                    let _ = std::fs::remove_file(&path);
	                                    seen_mints.insert(id);
	                                    continue;
	                                }
	                            }
	                            let buf = match std::fs::read(&path) {
	                                Ok(b) => b,
	                                Err(e) => {
	                                    match classify_mint_file_read_error(&e) {
	                                        MintFileReadDisposition::SkipTransientMissing => {
	                                            continue;
	                                        }
	                                        MintFileReadDisposition::DropUnreadable => {
	                                            warn!(file = %path.display(), err = %e, "mint file read failed");
	                                            // Avoid retry loops on permanently unreadable files.
	                                            let _ = std::fs::remove_file(&path);
	                                            seen_mints.insert(id);
	                                        }
	                                    }
	                                    continue;
	                                }
	                            };
	                            let mint = match pc_codec::decode_exact::<MintEvent>(&buf) {
	                                Ok(m) => m,
	                                Err(e) => {
	                                    warn!(file = %path.display(), err = %e, "mint file decode failed");
	                                    // Avoid retry loops on corrupt/invalid files.
	                                    let _ = std::fs::remove_file(&path);
	                                    seen_mints.insert(id);
	                                    continue;
	                                }
	                            };
	                            let digest = pc_types::digest_mint(&mint);
	                            if digest != id {
	                                warn!(file = %path.display(), "mint id mismatch (filename != digest)");
	                                let _ = std::fs::remove_file(&path);
	                                seen_mints.insert(id);
	                                continue;
	                            }

	                            if validate_mint_sanity(&mint).is_err() {
	                                warn!(mint_id = %hex::encode(id), "mint sanity failed (file)");
	                                let _ = std::fs::remove_file(&path);
	                                seen_mints.insert(id);
	                                continue;
	                            }

	                            let supply_guard = supply_mutex.lock().await;
	                            let bits = supply_guard.pow_bits;
	                            let mut last_id = supply_guard.last_mint_id;
	                            let mut supply_candidate = supply_guard.clone();
	                            drop(supply_guard);
	                            let mint_commitment = mint_id_v1(&mint);
	                            let already_applied = last_id == id;

	                            // Stale-mint hardening:
	                            // A mint whose `prev_mint_id` is already used can never become valid.
	                            // Drop it immediately to avoid CPU/disk DoS via forever-retries.
	                            if st.is_prev_mint_used(&mint.prev_mint_id) && !already_applied {
	                                warn!(
	                                    mint_id = %hex::encode(id),
	                                    prev_mint_id = %hex::encode(mint.prev_mint_id),
	                                    "prev_mint_id already used (stale mint file), dropping"
	                                );
	                                // Best-effort cleanup: mint file and its anti-replay seed marker.
	                                let seed_hex = hex::encode(mint.pow_seed);
	                                let seed_marker = std::path::Path::new(&mempool_path)
	                                    .join("mint_seeds")
	                                    .join(seed_hex);
	                                let _ = std::fs::remove_file(&seed_marker);
	                                let _ = std::fs::remove_file(&path);
	                                seen_mints.insert(id);
	                                continue;
	                            }

	                            if mint.prev_mint_id != last_id {
	                                if !already_applied {
	                                    // Noch nicht auf dem aktuellen Tip → später erneut versuchen
	                                    continue;
	                                }
	                                let mint_total: u64 = mint.outputs.iter().map(|o| o.amount).sum();
	                                if supply_candidate.mint_height == 0
	                                    || supply_candidate.total_supply < mint_total as u128
	                                {
	                                    warn!(
	                                        mint_id = %hex::encode(id),
	                                        "mint supply state inconsistent (already applied)"
	                                    );
	                                    let _ = std::fs::remove_file(&path);
	                                    seen_mints.insert(id);
	                                    continue;
	                                }
	                                supply_candidate.last_mint_id = mint.prev_mint_id;
	                                supply_candidate.mint_height =
	                                    supply_candidate.mint_height.saturating_sub(1);
	                                supply_candidate.total_supply = supply_candidate
	                                    .total_supply
	                                    .saturating_sub(mint_total as u128);
	                                last_id = mint.prev_mint_id;
	                            }
	                            if validate_mint_pow_bound_v1(&network_id, &mint, bits).is_err() {
	                                warn!(mint_id = %hex::encode(id), "mint pow bound failed (file)");
	                                let _ = std::fs::remove_file(&path);
	                                seen_mints.insert(id);
	                                continue;
	                            }
	                            if let Some(policy) = role_policy.as_ref() {
	                                if !policy.allows_mint(&mint) {
	                                    warn!(mint_id = %hex::encode(id), "mint rejected by role_policy (file)");
	                                    let _ = std::fs::remove_file(&path);
	                                    seen_mints.insert(id);
	                                    continue;
	                                }
	                            }
                            let next_anchor_index = anchor_index.saturating_add(1);
                            if supply_candidate.process_mint(&mint, next_anchor_index).is_err() {
                                // Falls die Kette noch nicht passt, später erneut
                                continue;
                            }

                            // mint-censor-v1 path:
                            // emit finalized-consensus candidate evidence (NoDecision payloads carry it later).
                            if let Some(rt) = mint_censor_runtime.as_mut() {
                                known_mints.insert(mint_commitment, mint.clone());
                                let forced_inclusion_v2_enabled = rt.forced_inclusion_v2_enabled;

                                let Some((window_id, window_open_anchor_id, candidate_target)) =
                                    rt.candidate_context_for_anchor(next_anchor_index, last_id)
                                else {
                                    continue;
                                };
                                let current_scope = (last_id, window_id);
                                match advance_candidate_scope(
                                    &mut active_candidate_scope,
                                    current_scope,
                                    &mut candidate_nonce_cursor,
                                    &mut emitted_candidate_work,
                                ) {
                                    CandidateScopeAdvance::Reset { previous } => {
                                        NODE_POW_CANDIDATE_SCOPE_RESETS_TOTAL.fetch_add(
                                            1,
                                            Ordering::Relaxed,
                                        );
                                        info!(
                                            previous_tip = %hex::encode(previous.0),
                                            previous_window_id = previous.1,
                                            tip = %hex::encode(current_scope.0),
                                            window_id = current_scope.1,
                                            "mint candidate scope reset"
                                        );
                                        NODE_POW_CANDIDATE_ACTIVE_WORK_SLOTS
                                            .store(0, Ordering::Relaxed);
                                    }
                                    CandidateScopeAdvance::Initialized => {
                                        NODE_POW_CANDIDATE_ACTIVE_WORK_SLOTS
                                            .store(0, Ordering::Relaxed);
                                    }
                                    CandidateScopeAdvance::Unchanged => {}
                                }
                                let work_id = pc_types::mint_work_id_v1(
                                    &network_id,
                                    &last_id,
                                    window_id,
                                    &window_open_anchor_id,
                                    &mint.pow_seed,
                                );
                                let encoded_work_id =
                                    runtime_candidate_work_id(work_id, rt.params.candidate_feature_bits);
                                let previous_best = emitted_candidate_work.get(&work_id).copied();

                                let mut candidate_ev = MintCandidateEvent {
                                    version: 1,
                                    network_id,
                                    prev_mint_id: last_id,
                                    window_id,
                                    window_open_anchor_id,
                                    mint_commitment,
                                    nonce: 0,
                                    work_id: encoded_work_id,
                                    miner_pubkey: None,
                                    recipient_lock: None,
                                };
                                let start_nonce = candidate_nonce_cursor
                                    .get(&work_id)
                                    .copied()
                                    .unwrap_or(mint.pow_nonce);
                                let (found_nonce, next_nonce_cursor) = mine_candidate_nonce_bounded(
                                    &candidate_ev,
                                    candidate_target,
                                    start_nonce,
                                    CANDIDATE_NONCE_ITERS_PER_TICK,
                                );
                                candidate_nonce_cursor.insert(work_id, next_nonce_cursor);

                                let Some(found_nonce) = found_nonce else {
                                    continue;
                                };
                                candidate_ev.nonce = found_nonce;
                                let candidate_id = pc_types::candidate_id_v1(&candidate_ev);
                                let candidate_pow_hash = pc_types::candidate_pow_hash_v1(&candidate_ev);
                                if let Some(prev) = previous_best {
                                    let replacement_cmp = candidate_replaces_existing_best(
                                        &candidate_pow_hash,
                                        &mint_commitment,
                                        &candidate_id,
                                        &prev.candidate_pow_hash,
                                        &prev.mint_commitment,
                                        &prev.candidate_id,
                                    )
                                    ;
                                    if !replacement_cmp {
                                        NODE_POW_CANDIDATE_SKIPPED_NOT_BETTER_TOTAL
                                            .fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    NODE_POW_CANDIDATE_REPLACED_TOTAL
                                        .fetch_add(1, Ordering::Relaxed);
                                }

                                if let Some(prev) = previous_best {
                                    let _ = evidence_pool.remove(&prev.candidate_evidence_id);
                                    if let Some(pos) = evidence_order
                                        .iter()
                                        .position(|k| *k == prev.candidate_evidence_id)
                                    {
                                        let _ = evidence_order.remove(pos);
                                    }
                                    let old_path = evidences_dir
                                        .join(format!("{}.bin", hex::encode(prev.candidate_evidence_id)));
                                    let _ = journal_append(
                                        &evidence_journal_path,
                                        fsync_flag,
                                        b'D',
                                        &prev.candidate_evidence_id,
                                    );
                                    let _ = remove_with_dir_sync(&old_path, fsync_flag);

                                    if let Some(old_cert_id) = prev.pow_cert_evidence_id {
                                        let _ = evidence_pool.remove(&old_cert_id);
                                        if let Some(pos) = evidence_order.iter().position(|k| *k == old_cert_id) {
                                            let _ = evidence_order.remove(pos);
                                        }
                                        let old_cert_path =
                                            evidences_dir.join(format!("{}.bin", hex::encode(old_cert_id)));
                                        let _ = journal_append(
                                            &evidence_journal_path,
                                            fsync_flag,
                                            b'D',
                                            &old_cert_id,
                                        );
                                        let _ = remove_with_dir_sync(&old_cert_path, fsync_flag);
                                    }
                                }

                                let ev = EvidenceEvent {
                                    version: 1,
                                    evidence: EvidenceKind::MintCandidateV1 {
                                        candidate: candidate_ev.clone(),
                                    },
                                };
                                if let Err(e) = pc_types::validate_evidence_sanity(&ev) {
                                    warn!(
                                        mint_id = %hex::encode(mint_commitment),
                                        err = %e,
                                        "mint candidate evidence sanity failed"
                                    );
                                    continue;
                                }

                                let evid_id = pc_types::digest_evidence(&ev);
                                if evidence_pool.contains_key(&evid_id) {
                                    emitted_candidate_work.insert(
                                        work_id,
                                        EmittedWorkState {
                                            candidate_id,
                                            candidate_pow_hash,
                                            mint_commitment,
                                            candidate_evidence_id: evid_id,
                                            pow_cert_evidence_id: None,
                                        },
                                    );
                                    NODE_POW_CANDIDATE_ACTIVE_WORK_SLOTS.store(
                                        emitted_candidate_work.len() as u64,
                                        Ordering::Relaxed,
                                    );
                                    continue;
                                }

                                if evidence_pool.len() >= EVIDENCE_MAX {
                                    if let Some(old_id) = evidence_order.pop_front() {
                                        let _ = evidence_pool.remove(&old_id);
                                        let old_fname = format!("{}.bin", hex::encode(old_id));
                                        let old_path = evidences_dir.join(old_fname);
                                        let _ = journal_append(
                                            &evidence_journal_path,
                                            fsync_flag,
                                            b'D',
                                            &old_id,
                                        );
                                        let _ = remove_with_dir_sync(&old_path, fsync_flag);
                                    }
                                }

                                let mut ev_buf: Vec<u8> = Vec::with_capacity(ev.encoded_len());
                                if ev.encode(&mut ev_buf).is_err() {
                                    warn!(
                                        mint_id = %hex::encode(mint_commitment),
                                        "mint candidate evidence encoding failed"
                                    );
                                    continue;
                                }
                                let evid_path =
                                    evidences_dir.join(format!("{}.bin", hex::encode(evid_id)));
                                if let Err(e) = atomic_write_async(&evid_path, ev_buf, fsync_flag).await {
                                    warn!(
                                        mint_id = %hex::encode(mint_commitment),
                                        err = %e,
                                        "mint candidate evidence persist failed"
                                    );
                                    continue;
                                }
                                let _ = journal_append(&evidence_journal_path, fsync_flag, b'A', &evid_id);
                                evidence_pool.insert(evid_id, (ev, Instant::now()));
                                evidence_order.push_back(evid_id);
                                emitted_candidate_work.insert(
                                    work_id,
                                    EmittedWorkState {
                                        candidate_id,
                                        candidate_pow_hash,
                                        mint_commitment,
                                        candidate_evidence_id: evid_id,
                                        pow_cert_evidence_id: None,
                                    },
                                );
                                NODE_POW_CANDIDATE_ACTIVE_WORK_SLOTS.store(
                                    emitted_candidate_work.len() as u64,
                                    Ordering::Relaxed,
                                );
                                NODE_POW_CANDIDATE_QUEUED_TOTAL.fetch_add(1, Ordering::Relaxed);

                                mint_tick_processed += 1;
                                info!(
                                    mint_id = %hex::encode(mint_commitment),
                                    evidence_id = %hex::encode(evid_id),
                                    work_id = %hex::encode(work_id),
                                    window_id,
                                    replacement = previous_best.is_some(),
                                    "mint candidate queued"
                                );

                                if forced_inclusion_v2_enabled {
                                    let cert = MintPoWCertV1 {
                                        version: 1,
                                        network_id,
                                        prev_mint_id: last_id,
                                        window_id,
                                        window_open_anchor_id,
                                        mint_commitment,
                                        nonce: found_nonce,
                                        work_id: encoded_work_id,
                                    };
                                    let cert_ev = EvidenceEvent {
                                        version: 1,
                                        evidence: EvidenceKind::MintPoWCertV1 { cert },
                                    };
                                    if let Err(e) = pc_types::validate_evidence_sanity(&cert_ev) {
                                        warn!(
                                            mint_id = %hex::encode(mint_commitment),
                                            err = %e,
                                            "mint pow-cert evidence sanity failed"
                                        );
                                        continue;
                                    }
                                    let cert_evid_id = pc_types::digest_evidence(&cert_ev);
                                    if !evidence_pool.contains_key(&cert_evid_id) {
                                        if evidence_pool.len() >= EVIDENCE_MAX {
                                            if let Some(old_id) = evidence_order.pop_front() {
                                                let _ = evidence_pool.remove(&old_id);
                                                let old_fname = format!("{}.bin", hex::encode(old_id));
                                                let old_path = evidences_dir.join(old_fname);
                                                let _ = journal_append(
                                                    &evidence_journal_path,
                                                    fsync_flag,
                                                    b'D',
                                                    &old_id,
                                                );
                                                let _ = remove_with_dir_sync(&old_path, fsync_flag);
                                            }
                                        }
                                        let mut cert_buf: Vec<u8> =
                                            Vec::with_capacity(cert_ev.encoded_len());
                                        if cert_ev.encode(&mut cert_buf).is_err() {
                                            warn!(
                                                mint_id = %hex::encode(mint_commitment),
                                                "mint pow-cert evidence encoding failed"
                                            );
                                            continue;
                                        }
                                        let cert_path = evidences_dir
                                            .join(format!("{}.bin", hex::encode(cert_evid_id)));
                                        if let Err(e) =
                                            atomic_write_async(&cert_path, cert_buf, fsync_flag)
                                                .await
                                        {
                                            warn!(
                                                mint_id = %hex::encode(mint_commitment),
                                                err = %e,
                                                "mint pow-cert evidence persist failed"
                                            );
                                            continue;
                                        }
                                        let _ = journal_append(
                                            &evidence_journal_path,
                                            fsync_flag,
                                            b'A',
                                            &cert_evid_id,
                                        );
                                        evidence_pool.insert(cert_evid_id, (cert_ev, Instant::now()));
                                        evidence_order.push_back(cert_evid_id);
                                        if let Some(slot) = emitted_candidate_work.get_mut(&work_id) {
                                            slot.pow_cert_evidence_id = Some(cert_evid_id);
                                        }
                                        info!(
                                            mint_id = %hex::encode(mint_commitment),
                                            evidence_id = %hex::encode(cert_evid_id),
                                            work_id = %hex::encode(work_id),
                                            window_id,
                                            "mint pow-cert queued"
                                        );
                                    }
                                }
                                continue;
                            }

                            let payload = pc_types::AnchorPayloadV3 {
                                version: 3,
                                micro_txs: vec![],
                                mints: vec![mint.clone()],
                                claims: vec![],
                                evidences: vec![],
                                payout_root: [0u8;32],
                                genesis_note: None,
                                null_mint: false,
                            };
                            let root = pc_types::payload_merkle_root_v3(&payload);
                            let _ = svc_prop.put_payload(payload.clone()).await;
                            let _ = std::fs::write(&payloads_signal_path, hex::encode(root));
                            let _ = tx_b_prop.send(P2pMessage::PayloadInv { roots: vec![root] }).await;

                            // Lokal penden (wie bei eingehenden Payloads)
                            if !pending.contains_key(&root) {
                                if pending.len() >= PENDING_MAX {
                                    if let Some(old_key) = order.pop_front() {
                                        let _ = pending.remove(&old_key);
                                        warn!(root = %hex::encode(old_key), "evicted oldest pending payload due to cap");
                                    }
                                }
                                let _ = pending.insert(root, (payload, Instant::now()));
                                order.push_back(root);
                            }

                            info!(mint_id = %hex::encode(id), root = %hex::encode(root), "mint announced via p2p");
                            seen_mints.insert(id);
                        }
                    }
                    // Interner Apply-Kandidat: queue den konkret final attestierten
                    // Commit-Kandidaten. Materialisierte Finalität bleibt strikt im Apply-Pfad.
                    Some(apply_candidate) = rx_apply_candidate.recv() => {
                        NODE_DBG_APPLYCAND_RECV.fetch_add(1, Ordering::Relaxed);
                        finalized_queue.insert(
                            apply_candidate.vote_epoch,
                            apply_candidate.shard_id,
                            apply_candidate.header_id,
                            apply_candidate,
                        );
                        // Drain ready entries in epoch-order (vote_epoch, shard_id, header_hash)
                        while let Some((_fq_epoch, _fq_shard, _fq_hid, queued)) = finalized_queue.pop_next(|_epoch| num_shards_state) {
                        let root = queued.root;
                        let header_id = queued.header_id;
                        // Inner dedup: previous drain iteration may have applied this root
                        if applied_final_headers.contains(&header_id) {
                            NODE_DBG_APPLYCAND_ALREADY_APPLIED.fetch_add(1, Ordering::Relaxed);
                            {
                                let mut g = finals_for_state.lock().await;
                                cleanup_finalized_header_entry(&mut g, header_id);
                            }
                            if pending.remove(&root).is_some() {
                                if let Some(pos) = order.iter().position(|k| *k == root) {
                                    let _ = order.remove(pos);
                                }
                                NODE_PROPOSER_PENDING.store(pending.len() as u64, Ordering::Relaxed);
                            }
                            continue;
                        }
                        let finalized_headers = [queued];

                        let mut payload: Option<pc_types::AnchorPayloadV3> = None;
                        if let Some((p, _ts)) = pending.remove(&root) {
                            // aus Order entfernen
                            if let Some(pos) = order.iter().position(|k| *k == root) {
                                let _ = order.remove(pos);
                            }
                            payload = Some(p);
                        } else {
                            // Fallback: falls wir den Payload nicht via P2P-Resp gesehen haben,
                            // versuche ihn aus dem lokalen Store zu laden (robust gegen Startup-Races).
                            if let Ok(store) = FileStore::open(&store_dir_for_warn, fsync_flag) {
                                if let Ok(Some(p3)) = store.get_payload_v3(&root) {
                                    payload = Some(p3);
                                }
                            }
                        }

                        let Some(p) = payload else {
                            NODE_DBG_APPLYCAND_PAYLOAD_UNAVAIL.fetch_add(1, Ordering::Relaxed);
                            warn!(root = %hex::encode(root), "finalized apply-candidate payload root not available yet");
                            continue;
                        };
                        for m in &p.mints {
                            known_mints.entry(mint_id_v1(m)).or_insert_with(|| m.clone());
                        }

                        if let Err(e) = pc_types::validate_payload_sanity_v3(&p) {
                            NODE_DBG_APPLYCAND_SANITY_FAIL.fetch_add(1, Ordering::Relaxed);
                            warn!(root = %hex::encode(root), err = %e, "drop pending payload: invalid");
                            continue;
                        }
                        if p.mints.len() > 1 {
                            NODE_DBG_APPLYCAND_SANITY_FAIL.fetch_add(1, Ordering::Relaxed);
                            warn!(root = %hex::encode(root), "drop pending payload: too many mints");
                            continue;
                        }
                        let next_anchor_index = anchor_index.saturating_add(1);
                        if let Some(rt) = mint_censor_runtime.as_mut() {
                            let state_last_mint_id = {
                                let g = supply_mutex.lock().await;
                                g.last_mint_id
                            };
                            if let Err(e) = rt.validate_final_payload(
                                &p,
                                root,
                                next_anchor_index,
                                state_last_mint_id,
                            ) {
                                NODE_DBG_APPLYCAND_MINT_CENSOR_FAIL.fetch_add(1, Ordering::Relaxed);
                                let has_mints = !p.mints.is_empty();
                                let w = rt.params.w;
                                let wid = if w > 0 { (next_anchor_index.saturating_sub(rt.params.windows_start_anchor)) / w } else { 0 };
                                let close = rt.params.windows_start_anchor + wid * w + w.saturating_sub(1);
                                warn!(
                                    root = %hex::encode(root),
                                    err = %e,
                                    anchor_index = anchor_index,
                                    next_anchor_index = next_anchor_index,
                                    has_mints = has_mints,
                                    window_id = wid,
                                    close_anchor = close,
                                    last_mint_id = %hex::encode(&state_last_mint_id[..8]),
                                    finalized_ids_len = rt.finalized_anchor_ids.len(),
                                    windows_len = rt.windows.len(),
                                    "drop pending payload: mint-censor-v1 validation failed"
                                );
                                continue;
                            }
                        } else if payload_contains_mint_censor_evidences_v1(&p) {
                            warn!(
                                root = %hex::encode(root),
                                "drop pending payload: mint-censor evidences while feature disabled"
                            );
                            continue;
                        }
                        let matched_finalized_header =
                            match verify_payload_payout_root_against_finalized_headers(
                                &mut st,
                                &mempool_path,
                                network_id,
                                k_state,
                                next_anchor_index,
                                &p,
                                role_policy.as_deref(),
                                &finalized_headers,
                            )
                            .await
                            {
                                Ok(meta) => meta,
                                Err(e) => {
                                    NODE_DBG_APPLYCAND_PAYOUT_FAIL.fetch_add(1, Ordering::Relaxed);
                                    warn!(
                                        root = %hex::encode(root),
                                        header_candidates = finalized_headers.len(),
                                        err = %e,
                                        "defer pending payload: payout_root does not match finalized header set yet"
                                    );
                                    queue_pending_payload_with_cap(
                                        &mut pending,
                                        &mut order,
                                        root,
                                        p,
                                        PENDING_MAX,
                                    );
                                    NODE_PROPOSER_PENDING
                                        .store(pending.len() as u64, Ordering::Relaxed);
                                    continue;
                                }
                            };
                        if matched_finalized_header.header_id != queued.header_id {
                            warn!(
                                root = %hex::encode(root),
                                queued_header_id = %hex::encode(queued.header_id),
                                matched_header_id = %hex::encode(matched_finalized_header.header_id),
                                "defer pending payload: finalized header candidate does not match queued header"
                            );
                            queue_pending_payload_with_cap(
                                &mut pending,
                                &mut order,
                                root,
                                p,
                                PENDING_MAX,
                            );
                            NODE_PROPOSER_PENDING
                                .store(pending.len() as u64, Ordering::Relaxed);
                            continue;
                        }
                        let slash_ops = match verify_and_extract_slash_ops(
		                            &st,
		                            &mempool_path,
		                            network_id,
	                            role_policy.as_ref().map(|p| p.as_ref()),
	                            &mut slash_committee_cache,
	                            &p.evidences,
	                        )
	                        .await
	                        {
	                            Ok(v) => v,
	                            Err(e) => {
	                                warn!(root = %hex::encode(root), err = %e, "drop pending payload: slash tickets invalid");
	                                continue;
	                            }
	                        };
                        let burned_total: u128 = match st.preview_slash_ops(&slash_ops) {
                            Ok((_slashed, _rewarded, burned)) => burned,
                            Err(e) => {
                                warn!(root = %hex::encode(root), err = %e, "drop pending payload: slash preview invalid");
                                continue;
                            }
                        };
                        let mut next_supply: Option<pc_consensus::SupplyState> = None;
                        {
                            let supply_guard = supply_mutex.lock().await;
                            let bits = supply_guard.pow_bits;
                            let mut candidate = supply_guard.clone();
                            drop(supply_guard);

                            if burned_total > 0 {
                                candidate.total_supply = candidate.total_supply.saturating_sub(burned_total);
                            }

                            if !p.mints.is_empty() {
                                let mut mint_ok = true;
                                for m in &p.mints {
                                    if validate_mint_sanity(m).is_err() {
                                        mint_ok = false;
                                        break;
                                    }
                                    if validate_mint_pow_bound_v1(&network_id, m, bits).is_err() {
                                        mint_ok = false;
                                        break;
                                    }
                                    if let Some(policy) = role_policy.as_ref() {
                                        if !policy.allows_mint(m) {
                                            warn!(root = %hex::encode(root), "mint rejected by role_policy");
                                            mint_ok = false;
                                            break;
                                        }
                                    }
                                    if let Err(e) = rewind_preaccounted_supply_for_mint(&mut candidate, m) {
                                        warn!(root = %hex::encode(root), err = %e, "mint preaccount rewind failed");
                                        mint_ok = false;
                                        break;
                                    }
                                    if st.is_prev_mint_used(&m.prev_mint_id) {
                                        mint_ok = false;
                                        break;
                                    }
                                    if candidate.process_mint(m, next_anchor_index).is_err() {
                                        mint_ok = false;
                                        break;
                                    }
                                }
                                if !mint_ok {
                                    warn!(root = %hex::encode(root), "drop pending payload: mint validation failed");
                                    continue;
                                }
                            }

                            if burned_total > 0 || !p.mints.is_empty() {
                                next_supply = Some(candidate);
                            }
                        }
                        let wallet_events = collect_wallet_history_events_for_payload(
                            &st,
                            &p,
                            next_anchor_index,
                            root,
                        );
                        {
                            let nid = network_id;
                            let txs = &p.micro_txs;
                            let sig_ok = pc_state::verify_microtx_sigs_parallel(txs, &nid);
                            if !sig_ok {
                                warn!(root = %hex::encode(root), "parallel sig-verify found invalid signatures, falling back to tolerant apply");
                            }
                            let Some(committed_state_root) = queued.state_root else {
                                warn!(
                                    root = %hex::encode(root),
                                    queued_creator_index = queued.creator_index,
                                    "defer pending payload: queued finalized header missing post_state_root"
                                );
                                queue_pending_payload_with_cap(
                                    &mut pending,
                                    &mut order,
                                    root,
                                    p,
                                    PENDING_MAX,
                                );
                                NODE_PROPOSER_PENDING
                                    .store(pending.len() as u64, Ordering::Relaxed);
                                continue;
                            };
                            let pre_apply_snapshot = st.create_snapshot(anchor_index);
                            let apply_result = if sig_ok {
                                st.apply_payload_v2_tolerant_presigned(
                                    &p.mints, txs, &slash_ops,
                                    next_anchor_index, consts::MATURITY_L1, &nid,
                                )
                            } else {
                                st.apply_payload_v2_tolerant(
                                    &p.mints, txs, &slash_ops,
                                    next_anchor_index, consts::MATURITY_L1, &nid,
                                )
                            };
                            match apply_result {
                                Ok(skipped) => {
                                    if !skipped.is_empty() {
                                        warn!(root = %hex::encode(root), skipped = ?skipped, "tolerant apply: skipped {} micro_txs", skipped.len());
                                    }
                                    let post_exec_sr = st.root();
                                    if post_exec_sr != committed_state_root {
                                        warn!(
                                            root = %hex::encode(root),
                                            committed = %hex::encode(committed_state_root),
                                            post_exec = %hex::encode(post_exec_sr),
                                            "Precommit post_state_root mismatch – materialization rolled back (consensus fault guard)"
                                        );
                                        let _ = st.restore_snapshot(pre_apply_snapshot);
                                        queue_pending_payload_with_cap(
                                            &mut pending,
                                            &mut order,
                                            root,
                                            p,
                                            PENDING_MAX,
                                        );
                                        NODE_PROPOSER_PENDING
                                            .store(pending.len() as u64, Ordering::Relaxed);
                                        continue;
                                    }
                                }
                                Err(e) => {
                                    let _ = st.restore_snapshot(pre_apply_snapshot);
                                    warn!(root = %hex::encode(root), err = %e, "drop pending payload: slash/mint failed");
                                    continue;
                                }
                            }
                        }
                        if let Some(next_supply) = next_supply {
                            let supply_snapshot = {
                                let mut supply = supply_mutex.lock().await;
                                *supply = next_supply;
                                supply.clone()
                            };
                            let mempool_dir_clone = mempool_path.clone();
                            let _ = tokio::task::spawn_blocking(move || {
                                persist_supply_state_sync(&mempool_dir_clone, &supply_snapshot, fsync_flag);
                            })
                            .await;
                        }
                        if let Err(e) = append_wallet_history_events_async(
                            &wallet_history_journal_path,
                            fsync_flag,
                            wallet_events,
                        )
                        .await
                        {
                            warn!(
                                root = %hex::encode(root),
                                err = %e,
                                "wallet history append failed"
                            );
                        }
                        // final angewandt → AnchorIndex erhöhen
                        anchor_index = next_anchor_index;
                        NODE_ANCHOR_INDEX.store(anchor_index, Ordering::Relaxed);
                        // PEX: Anchor an P2P Service senden für PeerStore-TTL
                        let _ = svc_prop.set_anchor(anchor_index).await;
                        // persistieren
                        { let data = anchor_index.to_string().into_bytes(); let p = std::path::Path::new(&anchor_index_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                        { let data = format!("{}", hex::encode(root)).into_bytes(); let p = std::path::Path::new(&last_final_payload_root_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                        { let data = format!("{}\n", hex::encode(st.root())).into_bytes(); let p = std::path::Path::new(&state_root_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                        if applied_final_headers.insert(header_id) {
                            applied_final_headers_order.push_back(header_id);
                            while applied_final_headers_order.len() > APPLIED_FINAL_HEADERS_CAP {
                                if let Some(old) = applied_final_headers_order.pop_front() {
                                    applied_final_headers.remove(&old);
                                }
                            }
                        }
                        {
                            let mut g = finals_for_state.lock().await;
                            cleanup_finalized_header_entry(&mut g, header_id);
                        }
                        // Entferne bestätigte MicroTxs aus dem Mempool (inkl. Dateien) und zähle Invalidationen
		                        let mut invalidated: u64 = 0;
	                        for tx in &p.micro_txs {
	                            let id = digest_microtx(tx);
	                            if let Some((old_tx, _ts)) = mempool.remove(&id) {
	                                for tin in &old_tx.inputs {
	                                    if mempool_spent.get(&tin.prev_out) == Some(&id) {
	                                        mempool_spent.remove(&tin.prev_out);
	                                    }
	                                }
	                                invalidated = invalidated.saturating_add(1);
	                                if let Some(pos) = mempool_order.iter().position(|k| *k == id) {
	                                    let _ = mempool_order.remove(pos);
	                                }
	                                let fname = format!("{}.bin", hex::encode(id));
	                                let path = std::path::Path::new(&mempool_path).join(fname);
	                                let _ = journal_append(&journal_path, fsync_flag, b'D', &id);
	                                let _ = remove_with_dir_sync(&path, fsync_flag);
	                            }
	                        }
                        // Remove applied evidences from the local evidence pool (best-effort).
                        for ev in &p.evidences {
                            let id = pc_types::digest_evidence(ev);
                            if evidence_pool.remove(&id).is_some() {
                                if let Some(pos) = evidence_order.iter().position(|k| *k == id) {
                                    let _ = evidence_order.remove(pos);
                                }
                            }
                            let fname = format!("{}.bin", hex::encode(id));
                            let path = evidences_dir.join(fname);
                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                            let _ = remove_with_dir_sync(&path, fsync_flag);
                        }
                        if invalidated > 0 {
                            NODE_MEMPOOL_INVALIDATED_TOTAL.fetch_add(invalidated, Ordering::Relaxed);
                        }
                        NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
                        NODE_PROPOSER_PENDING.store(pending.len() as u64, Ordering::Relaxed);
                        NODE_DBG_APPLYCAND_APPLIED.fetch_add(1, Ordering::Relaxed);
                        NODE_FINALIZED_TX_TOTAL.fetch_add(
                            (p.micro_txs.len() + p.mints.len() + p.claims.len() + p.evidences.len()) as u64,
                            Ordering::Relaxed,
                        );
                        if !p.mints.is_empty() {
                            NODE_FINALITY_MINT_EVENTS.fetch_add(1, Ordering::Relaxed);
                        }
                        observe_finality_event_unknown_latency();
                        let r = st.root();
                        info!(root = %hex::encode(root), state_root = %hex::encode(r), "materialized finalized payload after apply-candidate execution");
                        } // end while let finalized_queue.pop_next
                    }
                    // Periodischer TTL-Cleanup
                    _ = tick.tick() => {
                        let now = Instant::now();
                        // Entferne abgelaufene Einträge von vorne
                        loop {
                            if let Some(front) = order.front().copied() {
                                if let Some((_, ts)) = pending.get(&front) {
                                    if now.duration_since(*ts) > Duration::from_secs(PENDING_TTL_SECS) {
                                        let _ = order.pop_front();
                                        let _ = pending.remove(&front);
                                        warn!(root = %hex::encode(front), "dropped pending payload due to TTL");
                                        continue;
                                    }
                                }
                            }
                            break;
                        }
                        NODE_PROPOSER_PENDING.store(pending.len() as u64, Ordering::Relaxed);
                        // Mempool TTL-Cleanup
                        loop {
	                            if let Some(front) = mempool_order.front().copied() {
	                                if let Some((_, ts)) = mempool.get(&front) {
	                                    if now.duration_since(*ts) > Duration::from_secs(MEMPOOL_TTL_SECS) {
	                                        let _ = mempool_order.pop_front();
	                                        if let Some((old_tx, _ts)) = mempool.remove(&front) {
	                                            for tin in &old_tx.inputs {
	                                                if mempool_spent.get(&tin.prev_out) == Some(&front) {
	                                                    mempool_spent.remove(&tin.prev_out);
	                                                }
	                                            }
	                                        }
	                                        // Datei löschen
	                                        let fname = format!("{}.bin", hex::encode(front));
	                                        let path = std::path::Path::new(&mempool_path).join(fname);
	                                        let _ = journal_append(&journal_path, fsync_flag, b'D', &front);
	                                        let _ = remove_with_dir_sync(&path, fsync_flag);
                                        NODE_MEMPOOL_TTL_EVICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
                                        continue;
                                    }
                                }
                            }
                            break;
                        }
                        // Evidence TTL-Cleanup
                        loop {
                            if let Some(front) = evidence_order.front().copied() {
                                if let Some((_, ts)) = evidence_pool.get(&front) {
                                    if now.duration_since(*ts) > Duration::from_secs(EVIDENCE_TTL_SECS) {
                                        let _ = evidence_order.pop_front();
                                        let _ = evidence_pool.remove(&front);
                                        let fname = format!("{}.bin", hex::encode(front));
                                        let path = evidences_dir.join(fname);
                                        let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &front);
                                        let _ = remove_with_dir_sync(&path, fsync_flag);
                                        continue;
                                    }
                                }
                            }
                            break;
                        }
                        // Journal-Komprimierung bei zu großer Datei
                        if let Ok(meta) = std::fs::metadata(&journal_path) {
                            if meta.len() > 5_000_000 { // ~5 MB Schwellwert
                                let _ = rewrite_mempool_journal(&journal_path, &mempool_order, fsync_flag);
                            }
                        }
                        if let Ok(meta) = std::fs::metadata(&evidence_journal_path) {
                            if meta.len() > 5_000_000 { // ~5 MB Schwellwert
                                let _ = rewrite_mempool_journal(&evidence_journal_path, &evidence_order, fsync_flag);
                            }
                        }
                    }
                    // Periodischer Tx-Proposer
                    _ = prop_tick.tick(), if proposer_enabled.load(Ordering::Relaxed) => {
                      for &proposer_shard_id in my_shard_ids.iter() {
                        // Guard: maximal ein ausstehender Payload pro Shard gleichzeitig.
                        // Bei k=1 ist Finalisierung sofort (~10ms), daher kein
                        // Throughput-Verlust. Pipelining (mehrere in-flight) ist
                        // erst bei k>1 nötig, wenn Finalisierung länger dauert.
                        if !pending.is_empty() {
                            continue;
                        }
                        // Proposer-Policy: bevorzugt kleine Txs, dann älter (Index aus mempool_order), ohne Konflikte/Reservierungen
                        let mut txs: Vec<MicroTx> = Vec::new();
                        let mut used: HashSet<OutPoint> = HashSet::new();
                        // Reservierte TX-IDs aus pending nicht erneut vorschlagen
                        let mut reserved_ids: HashSet<[u8;32]> = HashSet::new();
                        for (pl, _) in pending.values() { for tx in &pl.micro_txs { reserved_ids.insert(digest_microtx(tx)); } }
                        // Kandidaten sammeln mit Größe und Alter (Index) und Group-Key (LockCommitment der ersten Output)
                        type CandInfo = (MicroTx, [u8;32], usize, usize, [u8;32]);
                        let mut cands: Vec<CandInfo> = Vec::new();
                        for (idx, id) in mempool_order.iter().enumerate() {
                            if let Some((tx, _ts)) = mempool.get(id) {
                                let tx_id = digest_microtx(tx);
                                if reserved_ids.contains(&tx_id) { continue; }
                                if shard_for_tx(tx, num_shards_state) != proposer_shard_id { continue; }
                                let size = tx.encoded_len();
                                let group_key = tx.outputs.first().map(|o| o.lock.0).unwrap_or([0u8;32]);
                                cands.push((tx.clone(), *id, size, idx, group_key));
                            }
                        }
                        // Sortiere Kandidaten nach Größe, dann Alter
                        cands.sort_by(|a, b| a.2.cmp(&b.2).then(a.3.cmp(&b.3)));
                        // Round-Robin über Gruppen: deterministische Gruppenreihenfolge
                        use std::collections::BTreeMap;
                        let mut groups: BTreeMap<[u8;32], Vec<(MicroTx, usize)>> = BTreeMap::new();
                        for (tx, _id, size, _idx, gk) in cands.into_iter() {
                            groups.entry(gk).or_default().push((tx, size));
                        }
                        // Budget-Logik
                        let mut budget_used: usize = 0;
                        'outer: loop {
                            let mut progressed = false;
                            for (_gk, vecq) in groups.iter_mut() {
                                // Nimm nächste Tx der Gruppe, die konfliktfrei ist und ins Budget passt
                                while let Some((tx, sz)) = vecq.first().cloned() {
                                    let mut conflict = false;
                                    for tin in &tx.inputs { if used.contains(&tin.prev_out) { conflict = true; break; } }
                                    if conflict { let _ = vecq.remove(0); continue; }
                                    if let Some(b) = payload_budget { if budget_used + sz > b { break; } }
                                    // accept
                                    for tin in &tx.inputs { let _ = used.insert(tin.prev_out); }
                                    txs.push(tx);
                                    budget_used += sz;
                                    let _ = vecq.remove(0);
                                    progressed = true;
                                    if txs.len() >= proposer_cap { break 'outer; }
                                    break;
                                }
                            }
                            if !progressed { break; }
                        }
                        let next_anchor_index = anchor_index.saturating_add(1);
                        let state_last_mint_id = if mint_censor_runtime.is_some() {
                            let g = supply_mutex.lock().await;
                            g.last_mint_id
                        } else {
                            [0u8; 32]
                        };
                        let active_mint_censor_window = mint_censor_runtime
                            .as_mut()
                            .and_then(|rt| {
                                rt.validation_window_key_for_anchor(
                                    next_anchor_index,
                                    state_last_mint_id,
                                )
                            });

                        // Evidence selection: include pending evidences unless already reserved in pending payloads.
                        let mut reserved_evid_ids: HashSet<[u8;32]> = HashSet::new();
                        for (pl, _) in pending.values() {
                            for ev in &pl.evidences {
                                reserved_evid_ids.insert(pc_types::digest_evidence(ev));
                            }
                        }
                        let mut evids: Vec<EvidenceEvent> = Vec::new();
                        if !evidence_pool.is_empty() {
                            let mut cand_ids: Vec<[u8;32]> = evidence_order
                                .iter()
                                .copied()
                                .filter(|id| !reserved_evid_ids.contains(id))
                                .collect();
                            // Deterministic order across nodes given the same pool.
                            cand_ids.sort_unstable();
                            for id in cand_ids.into_iter() {
                                if evids.len() >= pc_types::MAX_PAYLOAD_EVIDENCES {
                                    break;
                                }
                                if let Some((ev, _ts)) = evidence_pool.get(&id) {
                                    if mint_censor_evidence_ingest_allowed(
                                        ev,
                                        mint_censor_runtime.as_ref(),
                                    )
                                    .is_err()
                                    {
                                        continue;
                                    }
                                    // Keep mint-censor candidate/cert evidences aligned
                                    // with the exact window validate_final_payload will use.
                                    if let Some(rt) = mint_censor_runtime.as_ref() {
                                        let mismatched = match &ev.evidence {
                                            EvidenceKind::MintCandidateV1 { candidate } => {
                                                match active_mint_censor_window {
                                                    Some(active_key)
                                                        if (candidate.prev_mint_id, candidate.window_id)
                                                            != active_key =>
                                                    {
                                                        true
                                                    }
                                                    Some(active_key) => match rt.windows.get(&active_key)
                                                    {
                                                        Some(ws) => {
                                                            candidate.window_open_anchor_id
                                                                != ws.window_open_anchor_id
                                                        }
                                                        None => true,
                                                    },
                                                    None => true,
                                                }
                                            }
                                            EvidenceKind::MintPoWCertV1 { cert } => {
                                                match active_mint_censor_window {
                                                    Some(active_key)
                                                        if (cert.prev_mint_id, cert.window_id)
                                                            != active_key =>
                                                    {
                                                        true
                                                    }
                                                    Some(active_key) => match rt.windows.get(&active_key)
                                                    {
                                                        Some(ws) => {
                                                            cert.window_open_anchor_id
                                                                != ws.window_open_anchor_id
                                                        }
                                                        None => true,
                                                    },
                                                    None => true,
                                                }
                                            }
                                            _ => false,
                                        };
                                        if mismatched {
                                            continue;
                                        }
                                    }
                                    let sz = ev.encoded_len();
                                    if let Some(b) = payload_budget {
                                        if budget_used + sz > b {
                                            break;
                                        }
                                    }
                                    evids.push(ev.clone());
                                    budget_used += sz;
                                }
                            }
                            // Deterministic ordering inside the payload category.
                            evids.sort_unstable_by_key(pc_types::digest_evidence);
                        }

	                        let mut mint_decision = ProposerMintDecisionV1::None;
	                        if let Some(rt) = mint_censor_runtime.as_mut() {
                            mint_decision =
                                rt.proposal_mint_decision(next_anchor_index, state_last_mint_id);
                        }

	                        let mut proposed_mints: Vec<MintEvent> = Vec::new();
	                        let mut proposed_null_mint = false;
	                        match mint_decision {
	                            ProposerMintDecisionV1::None => {}
	                            ProposerMintDecisionV1::Null => {
	                                proposed_null_mint = true;
	                            }
	                            ProposerMintDecisionV1::Mint(winner_mint_id) => {
	                                let Some(m) = known_mints.get(&winner_mint_id).cloned() else {
	                                    warn!(
	                                        winner_mint_id = %hex::encode(winner_mint_id),
	                                        "mint-censor winner due but mint bytes are not available locally; skip propose tick"
                                    );
                                    continue;
                                };
                                proposed_mints.push(m);
                            }
                        }

                        // Heartbeat: when mint-censor is active the proposer must
                        // advance anchor_index even without content so that the
                        // deadline_anchor is eventually reached and a mint decision
                        // (Null or Mint) can be made.  Without heartbeat payloads the
                        // anchor_index stays stuck and the pipeline never progresses.
                        let heartbeat = mint_censor_runtime.is_some()
                            && txs.is_empty()
                            && evids.is_empty()
                            && !proposed_null_mint
                            && proposed_mints.is_empty();

                        if !txs.is_empty()
                            || !evids.is_empty()
                            || proposed_null_mint
                            || !proposed_mints.is_empty()
                            || heartbeat
                        {
                            // deterministische Ordnung: nach digest_microtx sortieren
                            txs.sort_unstable_by_key(digest_microtx);
                            let txs_len = txs.len();
                            let evid_len = evids.len();
                            let payout_root = match compute_payload_payout_root_strict(
                                &mut st,
                                &mempool_path,
                                network_id,
                                k_state,
                                next_anchor_index,
                                &txs,
                                role_policy.as_deref(),
                                local_validator_id_for_proposer,
                            )
                            .await
                            {
                                Ok(root) => root,
                                Err(e) => {
                                    warn!(
                                        err = %e,
                                        txs = txs_len,
                                        "skip propose tick: payout_root not computable"
                                    );
                                    continue;
                                }
                            };
                            let payload = pc_types::AnchorPayloadV3 {
                                version: 3,
                                micro_txs: txs,
                                mints: proposed_mints,
                                claims: vec![],
                                evidences: evids,
                                payout_root,
                                genesis_note: None,
                                null_mint: proposed_null_mint,
                            };
                            let root = pc_types::payload_merkle_root_v3(&payload);
                            let mints_len = payload.mints.len();
                            let is_null_mint = payload.null_mint;
                            let payload_clone = payload.clone();
                            match svc_prop.put_payload(payload).await {
                                Ok(()) => {
                                    NODE_PROPOSER_BUILT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                    NODE_PROPOSER_LAST_SIZE.store(txs_len as u64, Ordering::Relaxed);
                                    let _ = std::fs::write(&payloads_signal_path, hex::encode(root));
                                    // Für spätere State-Anwendung zwischenspeichern (Pending), falls nicht vorhanden
                                    if let std::collections::hash_map::Entry::Vacant(e) = pending.entry(root) {
                                        e.insert((payload_clone, Instant::now()));
                                        order.push_back(root);
                                    }
                                }
                                Err(_e) => {
                                    NODE_PROPOSER_ERRORS_TOTAL.fetch_add(1, Ordering::Relaxed);
                                }
                            }
                            if tx_b_prop.send(P2pMessage::PayloadInv { roots: vec![root] }).await.is_err() {
                                NODE_PROPOSER_ERRORS_TOTAL.fetch_add(1, Ordering::Relaxed);
                            }
                            info!(proposer = true, txs = txs_len, evidences = evid_len, mints = mints_len, null_mint = is_null_mint, root = %hex::encode(root), shard = proposer_shard_id, "proposed payload from mempool");
                        }
                      } // end for proposer_shard_id
                    }
                    res = rx_state.recv() => {
                        match res {
                            Ok(P2pMessage::Resp(RespMsg::Payloads { payloads })) => {
                                for p in payloads.into_iter() {
                                    let root = pc_types::payload_merkle_root_v3(&p);
                                    for m in &p.mints {
                                        known_mints.entry(mint_id_v1(m)).or_insert_with(|| m.clone());
                                    }
                                    let finalized_headers = {
                                        let g = finals_for_state.lock().await;
                                        finalized_headers_for_root(&g, root)
                                    };
                                    let had_finalized_headers = !finalized_headers.is_empty();
                                    let finalized_headers: Vec<_> = finalized_headers
                                        .into_iter()
                                        .filter(|meta| !applied_final_headers.contains(&meta.header_id))
                                        .collect();
                                    let apply = !finalized_headers.is_empty();
                                    if apply {
                                        if let Err(e) = pc_types::validate_payload_sanity_v3(&p) { warn!(root = %hex::encode(root), err = %e, "drop payload: invalid"); continue; }
                                        if p.mints.len() > 1 { warn!(root = %hex::encode(root), "drop payload: too many mints"); continue; }
                                        let next_anchor_index = anchor_index.saturating_add(1);
                                        if let Some(rt) = mint_censor_runtime.as_mut() {
                                            let state_last_mint_id = {
                                                let g = supply_mutex.lock().await;
                                                g.last_mint_id
                                            };
                                            if let Err(e) = rt.validate_final_payload(
                                                &p,
                                                root,
                                                next_anchor_index,
                                                state_last_mint_id,
                                            ) {
                                                warn!(
                                                    root = %hex::encode(root),
                                                    err = %e,
                                                    "drop payload: mint-censor-v1 validation failed"
                                                );
                                                continue;
                                            }
                                        } else if payload_contains_mint_censor_evidences_v1(&p) {
                                            warn!(
                                                root = %hex::encode(root),
                                                "drop payload: mint-censor evidences while feature disabled"
                                            );
                                            continue;
                                        }
                                        let matched_finalized_header =
                                            match verify_payload_payout_root_against_finalized_headers(
                                                &mut st,
                                                &mempool_path,
                                                network_id,
                                                k_state,
                                                next_anchor_index,
                                                &p,
                                                role_policy.as_deref(),
                                                &finalized_headers,
                                            )
                                            .await
                                            {
                                                Ok(meta) => meta,
                                                Err(e) => {
                                                    warn!(
                                                        root = %hex::encode(root),
                                                        header_candidates = finalized_headers.len(),
                                                        err = %e,
                                                        "defer payload: payout_root does not match finalized header set yet"
                                                    );
                                                    queue_pending_payload_with_cap(
                                                        &mut pending,
                                                        &mut order,
                                                        root,
                                                        p,
                                                        PENDING_MAX,
                                                    );
                                                    NODE_PROPOSER_PENDING
                                                        .store(pending.len() as u64, Ordering::Relaxed);
                                                    continue;
                                                }
                                            };
                                        let committed_state_root =
                                            matched_finalized_header.state_root;
                                        let Some(committed_state_root) = committed_state_root else {
                                            warn!(
                                                root = %hex::encode(root),
                                                matched_header_id = %hex::encode(matched_finalized_header.header_id),
                                                "defer payload: finalized header missing post_state_root"
                                            );
                                            queue_pending_payload_with_cap(
                                                &mut pending,
                                                &mut order,
                                                root,
                                                p,
                                                PENDING_MAX,
                                            );
                                            NODE_PROPOSER_PENDING
                                                .store(pending.len() as u64, Ordering::Relaxed);
                                            continue;
                                        };
                                        let slash_ops = match verify_and_extract_slash_ops(
		                                            &st,
		                                            &mempool_path,
		                                            network_id,
	                                            role_policy.as_ref().map(|p| p.as_ref()),
	                                            &mut slash_committee_cache,
	                                            &p.evidences,
	                                        )
	                                        .await
	                                        {
	                                            Ok(v) => v,
	                                            Err(e) => {
	                                                warn!(root = %hex::encode(root), err = %e, "drop payload: slash tickets invalid");
	                                                continue;
	                                            }
	                                        };
                                        let burned_total: u128 = match st.preview_slash_ops(&slash_ops) {
                                            Ok((_slashed, _rewarded, burned)) => burned,
                                            Err(e) => {
                                                warn!(root = %hex::encode(root), err = %e, "drop payload: slash preview invalid");
                                                continue;
                                            }
                                        };
                                        let mut next_supply: Option<pc_consensus::SupplyState> = None;
                                        {
                                            let supply_guard = supply_mutex.lock().await;
                                            let bits = supply_guard.pow_bits;
                                            let mut candidate = supply_guard.clone();
                                            drop(supply_guard);

                                            if burned_total > 0 {
                                                candidate.total_supply = candidate.total_supply.saturating_sub(burned_total);
                                            }

                                            if !p.mints.is_empty() {
                                                let mut mint_ok = true;
                                                for m in &p.mints {
                                                    if let Err(e) = validate_mint_sanity(m) {
                                                        warn!(root = %hex::encode(root), err = %e, "mint sanity check failed (apply)");
                                                        mint_ok = false;
                                                        break;
                                                    }
                                                    if let Err(e) = validate_mint_pow_bound_v1(&network_id, m, bits) {
                                                        warn!(root = %hex::encode(root), err = %e, nid = %hex::encode(network_id), bits = bits, "mint pow bound failed (apply)");
                                                        mint_ok = false;
                                                        break;
                                                    }
                                                    if let Some(policy) = role_policy.as_ref() {
                                                        if !policy.allows_mint(m) {
                                                            warn!(root = %hex::encode(root), "mint rejected by role_policy (apply)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                    }
                                                    if let Err(e) =
                                                        rewind_preaccounted_supply_for_mint(
                                                            &mut candidate,
                                                            m,
                                                        )
                                                    {
                                                        warn!(root = %hex::encode(root), err = %e, "mint preaccount rewind failed (apply)");
                                                        mint_ok = false;
                                                        break;
                                                    }
                                                    if st.is_prev_mint_used(&m.prev_mint_id) {
                                                        warn!(root = %hex::encode(root), prev_mint_id = %hex::encode(m.prev_mint_id), "prev_mint_id already used (apply)");
                                                        mint_ok = false;
                                                        break;
                                                    }
                                                    if let Err(e) = candidate.process_mint(m, next_anchor_index) {
                                                        warn!(root = %hex::encode(root), err = %e, "process_mint failed (apply)");
                                                        mint_ok = false;
                                                        break;
                                                    }
                                                }
                                                if !mint_ok {
                                                    warn!(root = %hex::encode(root), "drop payload: mint validation failed");
                                                    continue;
                                                }
                                            }

                                            if burned_total > 0 || !p.mints.is_empty() {
                                                next_supply = Some(candidate);
                                            }
                                        }
                                        let wallet_events = collect_wallet_history_events_for_payload(
                                            &st,
                                            &p,
                                            next_anchor_index,
                                            root,
                                        );
                                        {
                                            let nid = network_id;
                                            let txs = &p.micro_txs;
                                            let sig_ok = pc_state::verify_microtx_sigs_parallel(txs, &nid);
                                            if !sig_ok {
                                                warn!(root = %hex::encode(root), "parallel sig-verify found invalid signatures, falling back to tolerant apply");
                                            }
                                            let pre_apply_snapshot = st.create_snapshot(anchor_index);
                                            let apply_result = if sig_ok {
                                                st.apply_payload_v2_tolerant_presigned(
                                                    &p.mints, txs, &slash_ops,
                                                    next_anchor_index, consts::MATURITY_L1, &nid,
                                                )
                                            } else {
                                                st.apply_payload_v2_tolerant(
                                                    &p.mints, txs, &slash_ops,
                                                    next_anchor_index, consts::MATURITY_L1, &nid,
                                                )
                                            };
                                            match apply_result {
                                                Ok(skipped) => {
                                                    if !skipped.is_empty() {
                                                        warn!(root = %hex::encode(root), skipped = ?skipped, "tolerant apply: skipped {} micro_txs", skipped.len());
                                                    }
                                                    let post_exec_sr = st.root();
                                                    if post_exec_sr != committed_state_root {
                                                        warn!(
                                                            root = %hex::encode(root),
                                                            matched_header_id = %hex::encode(matched_finalized_header.header_id),
                                                            committed = %hex::encode(committed_state_root),
                                                            post_exec = %hex::encode(post_exec_sr),
                                                            "Precommit post_state_root mismatch – materialization rolled back (consensus fault guard)"
                                                        );
                                                        let _ = st.restore_snapshot(pre_apply_snapshot);
                                                        queue_pending_payload_with_cap(
                                                            &mut pending,
                                                            &mut order,
                                                            root,
                                                            p,
                                                            PENDING_MAX,
                                                        );
                                                        NODE_PROPOSER_PENDING
                                                            .store(pending.len() as u64, Ordering::Relaxed);
                                                        continue;
                                                    }
                                                }
                                                Err(e) => {
                                                    let _ = st.restore_snapshot(pre_apply_snapshot);
                                                    warn!(root = %hex::encode(root), err = %e, "drop payload: slash/mint failed");
                                                    continue;
                                                }
                                            }
                                        }
                                        if let Some(next_supply) = next_supply {
                                            let supply_snapshot = {
                                                let mut supply = supply_mutex.lock().await;
                                                *supply = next_supply;
                                                supply.clone()
                                            };
                                            let mempool_dir_clone = mempool_path.clone();
                                            let _ = tokio::task::spawn_blocking(move || {
                                                persist_supply_state_sync(&mempool_dir_clone, &supply_snapshot, fsync_flag);
                                            })
                                            .await;
                                        }
                                        if let Err(e) = append_wallet_history_events_async(
                                            &wallet_history_journal_path,
                                            fsync_flag,
                                            wallet_events,
                                        )
                                        .await
                                        {
                                            warn!(
                                                root = %hex::encode(root),
                                                err = %e,
                                                "wallet history append failed"
                                            );
                                        }
                                        // final angewandt → AnchorIndex erhöhen
                                        anchor_index = next_anchor_index;
                                        NODE_ANCHOR_INDEX.store(anchor_index, Ordering::Relaxed);
                                        // PEX: Anchor an P2P Service senden für PeerStore-TTL
                                        let _ = svc_prop.set_anchor(anchor_index).await;
                                        // persistieren
                                        { let data = anchor_index.to_string().into_bytes(); let p = std::path::Path::new(&anchor_index_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                                        { let data = format!("{}\n", hex::encode(root)).into_bytes(); let p = std::path::Path::new(&last_final_payload_root_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                                        { let data = format!("{}\n", hex::encode(st.root())).into_bytes(); let p = std::path::Path::new(&state_root_path); let _ = atomic_write_async(p, data, fsync_flag).await; }
                                        if applied_final_headers.insert(matched_finalized_header.header_id) {
                                            applied_final_headers_order.push_back(matched_finalized_header.header_id);
                                            while applied_final_headers_order.len() > APPLIED_FINAL_HEADERS_CAP {
                                                if let Some(old) = applied_final_headers_order.pop_front() {
                                                    applied_final_headers.remove(&old);
                                                }
                                            }
                                        }
                                        {
                                            let mut g = finals_for_state.lock().await;
                                            cleanup_finalized_header_entry(
                                                &mut g,
                                                matched_finalized_header.header_id,
                                            );
                                        }
                                        // Remove applied evidences from the local evidence pool (best-effort).
                                        for ev in &p.evidences {
                                            let id = pc_types::digest_evidence(ev);
                                            if evidence_pool.remove(&id).is_some() {
                                                if let Some(pos) = evidence_order.iter().position(|k| *k == id) {
                                                    let _ = evidence_order.remove(pos);
                                                }
                                            }
                                            let fname = format!("{}.bin", hex::encode(id));
                                            let path = evidences_dir.join(fname);
                                            let _ = journal_append(&evidence_journal_path, fsync_flag, b'D', &id);
                                            let _ = remove_with_dir_sync(&path, fsync_flag);
                                        }
                                        NODE_FINALIZED_TX_TOTAL.fetch_add(
                                            (p.micro_txs.len() + p.mints.len() + p.claims.len() + p.evidences.len()) as u64,
                                            Ordering::Relaxed,
                                        );
                                        if !p.mints.is_empty() {
                                            NODE_FINALITY_MINT_EVENTS.fetch_add(1, Ordering::Relaxed);
                                        }
                                        observe_finality_event_unknown_latency();
                                        let r = st.root();
                                        info!(root = %hex::encode(root), state_root = %hex::encode(r), "materialized finalized payload on payload arrival");
                                    } else if had_finalized_headers {
                                        continue;
                                    } else {
                                        // Nur einmal penden (Duplikate ignorieren)
                                        if !pending.contains_key(&root) {
                                            // Evict bei Überlauf
                                            if pending.len() >= PENDING_MAX {
                                                if let Some(old_key) = order.pop_front() {
                                                    let _ = pending.remove(&old_key);
                                                    warn!(root = %hex::encode(old_key), "evicted oldest pending payload due to cap");
                                                }
                                            }
                                            // Nur valide Payloads penden
                                            if let Err(e) = pc_types::validate_payload_sanity_v3(&p) {
                                                warn!(root = %hex::encode(root), err = %e, "drop payload: invalid (not queued)");
                                            } else if p.mints.len() > 1 {
                                                warn!(root = %hex::encode(root), "drop payload: too many mints (not queued)");
                                            } else {
                                                // Mint-Validierung vor dem Queuen
                                                let mut mint_ok = true;
                                                if !p.mints.is_empty() {
                                                    let supply_guard = supply_mutex.lock().await;
                                                    let bits = supply_guard.pow_bits;
                                                    let mut candidate = supply_guard.clone();
                                                    drop(supply_guard);
                                                    let next_anchor_index = anchor_index.saturating_add(1);
                                                    for m in &p.mints {
                                                        if let Err(e) = validate_mint_sanity(m) {
                                                            warn!(root = %hex::encode(root), err = %e, "mint sanity check failed (pending)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                        if let Err(e) = validate_mint_pow_bound_v1(&network_id, m, bits) {
                                                            warn!(root = %hex::encode(root), err = %e, nid = %hex::encode(network_id), bits = bits, "mint pow bound failed (pending)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                        if let Some(policy) = role_policy.as_ref() {
                                                            if !policy.allows_mint(m) {
                                                                warn!(root = %hex::encode(root), "mint rejected by role_policy (pending)");
                                                                mint_ok = false;
                                                                break;
                                                            }
                                                        }
                                                        if let Err(e) =
                                                            rewind_preaccounted_supply_for_mint(
                                                                &mut candidate,
                                                                m,
                                                            )
                                                        {
                                                            warn!(root = %hex::encode(root), err = %e, "mint preaccount rewind failed (pending)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                        if st.is_prev_mint_used(&m.prev_mint_id) {
                                                            warn!(root = %hex::encode(root), prev_mint_id = %hex::encode(m.prev_mint_id), "prev_mint_id already used (pending)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                        if let Err(e) = candidate.process_mint(m, next_anchor_index) {
                                                            warn!(root = %hex::encode(root), err = %e, "process_mint failed (pending)");
                                                            mint_ok = false;
                                                            break;
                                                        }
                                                    }
                                                }
                                                if !mint_ok {
                                                    warn!(root = %hex::encode(root), "drop payload: mint validation failed (not queued)");
                                                } else {
                                                    let _ = pending.insert(root, (p, Instant::now()));
                                                    order.push_back(root);
                                                    warn!(root = %hex::encode(root), "queued payload: header not final yet");
                                                }
                                            }
                                        } else {
                                            warn!(root = %hex::encode(root), "duplicate payload ignored (pending exists)");
                                        }
                                    }
                                }
                            }
                            Ok(P2pMessage::Resp(RespMsg::Txs { txs })) => {
                                // Phase 1: Parallel sanity check + signature verify
                                let sanity_ok: Vec<bool> = txs.iter().map(|tx| validate_microtx_sanity(tx).is_ok()).collect();
                                let sig_ok = pc_state::verify_microtx_sigs_parallel_each(&txs, &network_id);
                                // Phase 2: Sequential stateful checks + mempool insert
                                for (i, tx) in txs.into_iter().enumerate() {
                                    if !sanity_ok.get(i).copied().unwrap_or(false) {
                                        warn!("drop microtx: invalid sanity");
                                        NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    if !sig_ok.get(i).copied().unwrap_or(false) {
                                        NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    let id = digest_microtx(&tx);
                                    if mempool.contains_key(&id) {
                                        NODE_MEMPOOL_DUPLICATE_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    // Shard filter.
                                    if !my_shard_ids.contains(&shard_for_tx(&tx, num_shards_state)) {
                                        NODE_MEMPOOL_SHARD_REJECT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    // Mempool-Overlay: verwerfe, wenn irgendein Input bereits im Mempool belegt ist.
                                    let mut conflict = false;
                                    for tin in &tx.inputs {
                                        if mempool_spent.contains_key(&tin.prev_out) {
                                            conflict = true;
                                            break;
                                        }
                                    }
                                    if conflict {
                                        NODE_MEMPOOL_CONFLICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    // Stateful-Check ohne Sig-Verify (Signaturen bereits parallel geprüft)
                                    if let Err(_e) = st.can_apply_micro_tx_presigned_no_maturity(&tx, &network_id) {
                                        NODE_MEMPOOL_REJECTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        continue;
                                    }
                                    // Cap-Eviction: älteste entfernen, falls voll
                                    if mempool.len() >= mempool_cap {
                                        if let Some(old_id) = mempool_order.pop_front() {
                                            if let Some((old_tx, _ts)) = mempool.remove(&old_id) {
                                                for tin in &old_tx.inputs {
                                                    if mempool_spent.get(&tin.prev_out) == Some(&old_id) {
                                                        mempool_spent.remove(&tin.prev_out);
                                                    }
                                                }
                                            }
                                            let old_fname = format!("{}.bin", hex::encode(old_id));
                                            let old_path = std::path::Path::new(&mempool_path).join(old_fname);
                                            let _ = journal_append(&journal_path, fsync_flag, b'D', &old_id);
                                            let _ = remove_with_dir_sync(&old_path, fsync_flag);
                                            NODE_MEMPOOL_CAP_EVICT_TOTAL.fetch_add(1, Ordering::Relaxed);
                                        }
                                    }
                                    let _ = mempool.insert(id, (tx.clone(), Instant::now()));
                                    mempool_order.push_back(id);
                                    for tin in &tx.inputs {
                                        let _ = mempool_spent.insert(tin.prev_out, id);
                                    }
                                    // Persistiere in store_dir/mempool/<hexid>.bin
                                    let fname = format!("{}.bin", hex::encode(id));
                                    let path = std::path::Path::new(&mempool_path).join(fname);
                                    let mut buf = Vec::with_capacity(tx.encoded_len());
                                    if tx.encode(&mut buf).is_ok()
                                        && atomic_write_async(&path, buf.clone(), fsync_flag)
                                            .await
                                            .is_ok()
                                    {
                                        let _ = journal_append(&journal_path, fsync_flag, b'A', &id);
                                    }
                                    NODE_MEMPOOL_ACCEPTED_TOTAL.fetch_add(1, Ordering::Relaxed);
                                    NODE_MEMPOOL_SIZE.store(mempool.len() as u64, Ordering::Relaxed);
                                }
                            }
                            Ok(_) => {}
                            Err(tokio::sync::broadcast::error::RecvError::Lagged(n)) => { NODE_INBOUND_OBS_LAGGED_TOTAL.fetch_add(n, Ordering::Relaxed); }
                            Err(tokio::sync::broadcast::error::RecvError::Closed) => { break; }
                        }
                    }
                }
            }
            Ok::<(), anyhow::Error>(())
        });

        if let Err(e) = tokio::signal::ctrl_c().await {
            return Err(anyhow!("failed to listen for ctrl_c: {e}"));
        }
        if let Some(tx) = metrics_shutdown_tx.take() {
            let _ = tx.send(());
        }
        svc.shutdown().await?;
        let _ = forward_task.await;
        let _ = server_task.await;
        let _ = consensus_task.await;
        let _ = state_task.await;
        if let Some(task) = metrics_task.take() {
            let _ = task.await;
        }
        let res = handle
            .await
            .map_err(|e| anyhow!("p2p task join error: {e}"))?;
        res.map_err(|e| anyhow!("p2p loop error: {e}"))
    })
}
