{
  "name": "phantom-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:tauri-prep": "cargo build -p phantom-signer -p phantom-node --bins && vite --port 5173 --strictPort",
    "build": "vite build",
    "build:tauri-prep": "cargo build --release -p phantom-signer -p phantom-node --bins && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "tauri": "tauri",
    "tauri:build:release": "tauri build --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uplot": "^1.6.30"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
