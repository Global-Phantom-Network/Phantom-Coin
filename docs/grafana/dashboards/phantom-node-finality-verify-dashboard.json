{
  "title": "Phantom Node - Finality & Verify",
  "schemaVersion": 38,
  "version": 1,
  "time": {"from":"now-6h","to":"now"},
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Finality p50/p95/p99 (s)",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(pc_node_finality_seconds_bucket[5m])))"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(pc_node_finality_seconds_bucket[5m])))"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(pc_node_finality_seconds_bucket[5m])))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Finality EPS",
      "targets": [
        {"expr": "rate(pc_node_finality_events_total[5m])"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Verify Latency p50/p95/p99 (s)",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(pc_node_verify_seconds_bucket[5m])))"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(pc_node_verify_seconds_bucket[5m])))"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(pc_node_verify_seconds_bucket[5m])))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Verify Rate (ops/s)",
      "targets": [
        {"expr": "rate(pc_node_verify_seconds_count[5m])"}
      ]
    }
  ]
}
